#!/usr/bin/env bash
# read-catalog — hands the model cache to the panel, or hands it nothing.
#
# The panel is not told the path and cannot pass one. Everything that makes this
# safe lives in bin/safe-read: one open with O_NOFOLLOW and O_NONBLOCK, every
# decision taken on that descriptor rather than on the name, and exactly the
# number of bytes that were vouched for read back through it. The name is resolved
# once, so there is nothing to race and nothing here to retry. See that file for
# what O_NOFOLLOW does and does not cover.
#
# Exit: 0 printed it. 1 there is no cache yet. 2 refused it. 3 could not read it.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ID="oliwier.opencode-configs"
FILE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/$PLUGIN_ID/models.json"

# Deliberately not overridable: one number, in one place, that the panel agrees
# with. It counts bytes on the wire — a QString of them costs the shell more.
MAX_BYTES=12582912

# --no-empty because a zero-length cache is an interrupted or out-of-space write,
# never a catalogue; refusing is what gets one rebuilt. No --follow: this is the
# plugin's own file, at a path anything running as this user can predict.
exec "$SELF_DIR/safe-read" "$FILE" \
  --max-bytes "$MAX_BYTES" --no-empty --label "the model cache"
