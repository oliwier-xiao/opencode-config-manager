#!/usr/bin/python3 -I
"""Read and surgically edit a JSONC config, keeping every byte this tool does not own.

oh-my-openagent's user config is ~/.omo/omo.jsonc — JSONC, with comments, and with
the opencode-specific half nested under an "[opencode]" key. jq cannot read comments
and a reserialise would drop them, so the edit has to be a splice: locate the span a
key's value occupies and replace only that span. Everything else in the file, down to
the whitespace, comes out the far side unchanged.

  jsonc-edit read  <file> [--scope KEY ...]
  jsonc-edit apply <file> --manages <json> [--scope KEY ...]   < payload

`read` prints the scoped object as compact JSON. `apply` reads the payload, one JSON
object, on stdin and prints the whole new file on stdout; the caller decides how it
lands on disk.

The payload is config content: a projection of a file that also holds provider API
keys and MCP tokens. A command line is readable by every account on the machine
through /proc/<pid>/cmdline, so the payload is never taken from one — `--payload` is
refused, not ignored, so a caller still passing it fails instead of leaking. Only key
names, the scope and the path travel as arguments.
"""
import importlib.machinery
import importlib.util
import json
import os
import sys

WS = " \t\r\n"

# A config can be a symlink into a dotfiles repository, which is a normal thing for
# someone to have done on purpose, so the name is followed here — but everything
# else bin/safe-read enforces still applies: one non-blocking open, the decision
# taken on that descriptor, a size ceiling, and no second look at the name. A FIFO
# or a device planted at the path is refused rather than stalling this process
# inside open(2).
MAX_CONFIG_BYTES = 4 * 1024 * 1024
# A payload is at most a projection of a config, so the same ceiling bounds it.
MAX_PAYLOAD_BYTES = MAX_CONFIG_BYTES


# No .pyc beside the script: this directory is the installed plugin, and a
# __pycache__ appearing in it after the first edit is noise the shell then ships.
sys.dont_write_bytecode = True


def _load_safe_read():
    # Explicit loader: the file has no .py suffix, so nothing can be inferred from
    # the name. Same directory as this script, never a search path.
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "safe-read")
    loader = importlib.machinery.SourceFileLoader("_safe_read", path)
    spec = importlib.util.spec_from_file_location("_safe_read", path, loader=loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


_safe = _load_safe_read()


class Bad(Exception):
    pass


def _not_json(token):
    # Python's json reads NaN, Infinity and -Infinity; JSON does not have them.
    raise ValueError("not JSON")


class Scanner:
    """A JSONC reader that records where every value starts and ends."""

    def __init__(self, text):
        self.s = text
        self.i = 0

    def skip(self):
        s, n = self.s, len(self.s)
        while self.i < n:
            c = s[self.i]
            if c in WS:
                self.i += 1
            elif c == "/" and self.i + 1 < n and s[self.i + 1] == "/":
                while self.i < n and s[self.i] != "\n":
                    self.i += 1
            elif c == "/" and self.i + 1 < n and s[self.i + 1] == "*":
                self.i += 2
                while self.i < n and not (s[self.i] == "*" and self.i + 1 < n and s[self.i + 1] == "/"):
                    self.i += 1
                self.i += 2
            else:
                return

    def string(self):
        s = self.s
        if s[self.i] != '"':
            raise Bad("expected a string at %d" % self.i)
        start = self.i
        self.i += 1
        while self.i < len(s):
            c = s[self.i]
            if c == "\\":
                self.i += 2
                continue
            self.i += 1
            if c == '"':
                return json.loads(s[start:self.i]), start, self.i
        raise Bad("unterminated string at %d" % start)

    def value(self):
        """Return (python value, node). node carries the span and, for objects, members."""
        self.skip()
        if self.i >= len(self.s):
            raise Bad("unexpected end of file")
        c = self.s[self.i]
        if c == "{":
            return self.obj()
        if c == "[":
            return self.arr()
        if c == '"':
            v, a, b = self.string()
            return v, {"kind": "value", "start": a, "end": b}
        start = self.i
        while self.i < len(self.s) and self.s[self.i] not in ",}]" + WS and not (
            self.s[self.i] == "/" and self.i + 1 < len(self.s) and self.s[self.i + 1] in "/*"
        ):
            self.i += 1
        raw = self.s[start:self.i]
        try:
            v = json.loads(raw, parse_constant=_not_json)
        except Exception:
            # Located, never quoted: the token is a piece of a file that holds
            # provider keys, and this message ends up wherever stderr does.
            raise Bad("cannot read the value at %d" % start)
        return v, {"kind": "value", "start": start, "end": self.i}

    def obj(self):
        start = self.i
        self.i += 1  # {
        out, members = {}, []
        while True:
            self.skip()
            if self.i >= len(self.s):
                raise Bad("unterminated object at %d" % start)
            if self.s[self.i] == "}":
                self.i += 1
                break
            member_start = self.i
            key, _, _ = self.string()
            self.skip()
            if self.i >= len(self.s) or self.s[self.i] != ":":
                raise Bad("expected ':' at %d" % self.i)
            self.i += 1
            val, node = self.value()
            out[key] = val
            member = {"key": key, "start": member_start, "value": node, "comma": None}
            members.append(member)
            # A comma between members is required, not optional: a reader that
            # shrugged off a missing one would call a broken file readable, and the
            # check that runs before anything is written would wave it through. One
            # after the last member is JSONC's own allowance, and is kept.
            self.skip()
            if self.i < len(self.s) and self.s[self.i] == ",":
                member["comma"] = self.i
                self.i += 1
            elif self.i < len(self.s) and self.s[self.i] == "}":
                pass
            else:
                raise Bad("expected ',' or '}' at %d" % self.i)
        return out, {"kind": "object", "start": start, "end": self.i, "members": members}

    def arr(self):
        start = self.i
        self.i += 1  # [
        out = []
        while True:
            self.skip()
            if self.i >= len(self.s):
                raise Bad("unterminated array at %d" % start)
            if self.s[self.i] == "]":
                self.i += 1
                break
            val, _ = self.value()
            out.append(val)
            self.skip()
            if self.i < len(self.s) and self.s[self.i] == ",":
                self.i += 1
            elif self.i < len(self.s) and self.s[self.i] == "]":
                pass
            else:
                raise Bad("expected ',' or ']' at %d" % self.i)
        return out, {"kind": "array", "start": start, "end": self.i, "members": []}


def parse(text):
    sc = Scanner(text)
    val, node = sc.value()
    sc.skip()
    if sc.i != len(text):
        raise Bad("trailing content at %d" % sc.i)
    return val, node


def detect_indent(text):
    for line in text.splitlines():
        stripped = line.lstrip(" \t")
        if stripped and stripped != line and stripped[0] == '"':
            lead = line[: len(line) - len(stripped)]
            return "\t" if lead.startswith("\t") else " " * len(lead)
    return "  "


def line_indent(text, offset):
    start = text.rfind("\n", 0, offset) + 1
    lead = ""
    for c in text[start:offset]:
        if c in " \t":
            lead += c
        else:
            break
    return lead


def render(value, base, unit):
    # Split on "\n" alone. str.splitlines() also breaks at U+2028, U+2029, U+0085 and
    # the other Unicode line boundaries, which json.dumps leaves raw inside a string
    # when ensure_ascii is off — cutting a string literal in two and writing a config
    # nothing can read.
    # allow_nan=False: NaN and Infinity are not JSON, and nothing that reads the
    # config would take them back.
    body = json.dumps(value, indent=len(unit) if unit != "\t" else 1, ensure_ascii=False,
                      allow_nan=False)
    if unit == "\t":
        body = "\n".join(
            (l.replace(" ", "\t", len(l) - len(l.lstrip(" "))) if l.startswith(" ") else l)
            for l in body.split("\n")
        )
    return ("\n" + base).join(body.split("\n"))


def _rest_of_line(text, pos):
    """Where the line holding `pos` ends, if nothing but blanks and a // comment
    follow `pos` on it; None if something else does."""
    i, n = pos, len(text)
    while i < n and text[i] in " \t\r":
        i += 1
    if i < n and text.startswith("//", i):
        while i < n and text[i] != "\n":
            i += 1
    if i >= n or text[i] == "\n":
        return i
    return None


def _member_base(text, node, member, unit):
    """The indentation a member written below `member` should carry."""
    ls = text.rfind("\n", 0, member["start"]) + 1
    if text[ls:member["start"]].strip(" \t") == "":
        return text[ls:member["start"]]
    # The member shares its line with the brace or another member: indent one
    # step in from the line the object opens on.
    return line_indent(text, node["start"]) + unit


def delete_member(text, node, key):
    """The text without `key`'s member, and without the one comma that went with it."""
    members = node["members"]
    j = max(i for i, m in enumerate(members) if m["key"] == key)
    m = members[j]
    start, end = m["start"], m["value"]["end"]
    if m["comma"] is not None:
        end = m["comma"] + 1
    elif j > 0:
        # The last member, with no comma of its own: the separator to take is the
        # one in front of it, which leaves the member before it last.
        start = members[j - 1]["comma"]
    # A comment trailing the member on its own line goes with it.
    le = _rest_of_line(text, end)
    if le is not None:
        end = le
    # And so does the line, when the member stood on one of its own.
    ls = text.rfind("\n", 0, start) + 1
    if text[ls:start].strip(" \t") == "" and (end >= len(text) or text[end] == "\n"):
        start = ls
        if end < len(text):
            end += 1
    return text[:start] + text[end:]


def replace_member(text, node, key, value, unit):
    m = [m for m in node["members"] if m["key"] == key][-1]
    base = line_indent(text, m["start"])
    v = m["value"]
    return text[:v["start"]] + render(value, base, unit) + text[v["end"]:]


def add_member(text, node, key, value, unit):
    members = node["members"]
    if not members:
        outer = line_indent(text, node["start"])
        inner_start, inner_end = node["start"] + 1, node["end"] - 1
        entry = "%s: %s" % (json.dumps(key, ensure_ascii=False), render(value, outer + unit, unit))
        if text[inner_start:inner_end].strip(WS) == "":
            return text[:inner_start] + "\n" + outer + unit + entry + "\n" + outer + text[inner_end:]
        # Only comments inside: the member goes first and they follow it.
        return text[:inner_start] + "\n" + outer + unit + entry + text[inner_start:]

    last = members[-1]
    base = _member_base(text, node, last, unit)
    entry = "%s: %s" % (json.dumps(key, ensure_ascii=False), render(value, base, unit))
    trailing = last["comma"] is not None
    anchor = last["comma"] + 1 if trailing else last["value"]["end"]
    le = _rest_of_line(text, anchor)
    if le is not None:
        # The last member ends its line, perhaps with a comment: the comma goes
        # straight after its value — never after the comment, where it would be part
        # of the comment — and the new member on a line of its own below.
        if trailing:
            return text[:le] + "\n" + base + entry + "," + text[le:]
        vend = last["value"]["end"]
        return text[:vend] + "," + text[vend:le] + "\n" + base + entry + text[le:]
    # Something else follows on the same line, such as the closing brace of a
    # one-line object: the member joins that line.
    if trailing:
        return text[:anchor] + " " + entry + "," + text[anchor:]
    vend = last["value"]["end"]
    return text[:vend] + ", " + entry + text[vend:]


def edit_one(text, node, key, value, unit):
    """Assign `value` to `key` (or remove it, for DELETE) in one object node."""
    present = any(m["key"] == key for m in node["members"])
    if value is DELETE:
        return delete_member(text, node, key) if present else text
    if present:
        return replace_member(text, node, key, value, unit)
    return add_member(text, node, key, value, unit)


def find_scope(root, scope):
    """The node `scope` names, or (depth, node) of the deepest object on its way."""
    node = root
    for depth, key in enumerate(scope):
        member = next((m for m in reversed(node["members"]) if m["key"] == key), None)
        if member is None or member["value"]["kind"] != "object":
            return None, depth, node
        node = member["value"]
    return node, len(scope), node


def apply_all(text, scope, updates, unit):
    """Every update, one splice at a time, each on the text the last one produced.

    Re-reading between edits is what keeps them honest: offsets taken from one
    parse and applied after another edit has moved the text are how two deletions
    once overlapped and cut the closing brace off a config.
    """
    doc, root = parse(text)
    target, depth, deepest = find_scope(root, scope)
    if target is None:
        # The scope is missing (or is not an object) from `depth` on. It is built
        # whole, in one assignment at the deepest object that does exist.
        container = doc
        for key in scope[:depth]:
            container = container[key]
        existing = container.get(scope[depth])
        nested = dict(existing) if isinstance(existing, dict) else {}
        for k, v in updates.items():
            if v is DELETE:
                nested.pop(k, None)
            else:
                nested[k] = v
        for k in scope[depth + 1:][::-1]:
            nested = {k: nested}
        return edit_one(text, deepest, scope[depth], nested, unit)
    for key, value in updates.items():
        _, root = parse(text)
        target, _, _ = find_scope(root, scope)
        text = edit_one(text, target, key, value, unit)
    return text


def expected_document(doc, scope, updates):
    """What the file must read as once the edit is done: the same document, with
    the updates made at the scope and nothing else different."""
    out = json.loads(json.dumps(doc))
    container = out
    for key in scope:
        if not isinstance(container.get(key), dict):
            container[key] = {}
        container = container[key]
    for k, v in updates.items():
        if v is DELETE:
            container.pop(k, None)
        else:
            container[k] = v
    return out


class _Delete:
    def __repr__(self):
        return "<delete>"


DELETE = _Delete()


def descend(value, scope):
    for key in scope:
        if not isinstance(value, dict) or key not in value:
            return None
        value = value[key]
    return value if isinstance(value, dict) else None


def read_payload(stream):
    """The payload off stdin: bounded, UTF-8, and one JSON object or nothing.

    One byte past the cap is asked for, so a payload exactly at it is accepted and
    anything longer is refused rather than parsed short. A terminal is refused
    instead of waited on: a person running this by hand gets told where the
    payload goes, not a prompt-less hang.
    """
    if stream is None or stream.closed:
        raise Bad("apply reads the payload on stdin, and there is no stdin")
    if stream.isatty():
        raise Bad("apply reads the payload on stdin; pipe it in")
    # A loop, because a read may come back short of what was asked for without
    # the stream being at its end.
    chunks, total = [], 0
    while True:
        chunk = stream.buffer.read(min(65536, MAX_PAYLOAD_BYTES + 1 - total))
        if chunk is None:
            raise Bad("stdin is non-blocking and had nothing to read")
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
        if total > MAX_PAYLOAD_BYTES:
            raise Bad("the payload is larger than %d bytes" % MAX_PAYLOAD_BYTES)
    # RecursionError is not a ValueError: a payload nested a few hundred deep would
    # otherwise end this in a traceback. The decoder's own message is not passed
    # on either; its exception carries the payload it was decoding.
    try:
        payload = json.loads(b"".join(chunks).decode("utf-8"))
    except (UnicodeDecodeError, ValueError, RecursionError):
        raise Bad("the payload on stdin is not JSON, or is nested too deeply") from None
    if not isinstance(payload, dict):
        raise Bad("the payload on stdin is not a JSON object")
    return payload


def emit(text):
    """The result, as UTF-8 whatever the locale says.

    The file was read as UTF-8, so it is written back as UTF-8. Going through
    sys.stdout instead encodes in the locale's charset: under a latin-1 locale,
    or a PYTHONIOENCODING that is not UTF-8, a config with one non-ASCII comment
    would come back re-encoded, or not at all.
    """
    sys.stdout.buffer.write(text.encode("utf-8"))
    sys.stdout.buffer.flush()


def main(argv):
    if len(argv) < 3:
        sys.stderr.write(__doc__)
        return 1
    mode, path = argv[1], argv[2]
    scope, manages = [], None
    i = 3
    while i < len(argv):
        a = argv[i]
        if a in ("--scope", "--manages") and i + 1 >= len(argv):
            sys.stderr.write("jsonc-edit: %s needs a value\n" % a)
            return 1
        if a == "--scope":
            scope.append(argv[i + 1]); i += 2
        elif a == "--manages":
            try:
                manages = json.loads(argv[i + 1])
            except ValueError:
                manages = None
            if not (isinstance(manages, list) and all(isinstance(k, str) for k in manages)):
                sys.stderr.write("jsonc-edit: --manages must be a JSON array of key names\n")
                return 1
            i += 2
        elif a == "--payload" or a.startswith("--payload="):
            # Refused before its value is so much as looked at. By the time this
            # runs the value has already been on the command line, so the refusal
            # cannot undo that; it can make sure the caller that did it fails loudly
            # every time, which is how it gets found and fixed.
            sys.stderr.write("jsonc-edit: --payload is not accepted; the command line is "
                             "readable by every account through /proc. Pipe the payload "
                             "on stdin.\n")
            return 1
        else:
            sys.stderr.write("jsonc-edit: unknown option %s\n" % a)
            return 1

    if mode not in ("read", "apply"):
        sys.stderr.write("jsonc-edit: unknown mode %s\n" % mode)
        return 1

    # The payload is taken whole before the file is so much as opened. A refusal
    # further down then leaves nobody upstream writing into a pipe that has
    # stopped being read.
    payload = None
    if mode == "apply":
        if manages is None:
            sys.stderr.write("jsonc-edit: apply needs --manages\n")
            return 1
        try:
            payload = read_payload(sys.stdin)
        except Bad as exc:
            sys.stderr.write("jsonc-edit: %s\n" % exc)
            return 1

    try:
        text = _safe.read_capped(path, MAX_CONFIG_BYTES, follow=True).decode("utf-8")
    except FileNotFoundError:
        sys.stderr.write("jsonc-edit: %s does not exist\n" % path)
        return 1
    except _safe.Refused as exc:
        sys.stderr.write("jsonc-edit: %s\n" % exc)
        return 1
    except (OSError, UnicodeDecodeError) as exc:
        sys.stderr.write("jsonc-edit: %s\n" % exc)
        return 1

    # A byte-order mark is read past and written back: editors that add one also
    # expect to find it again.
    bom = ""
    if text.startswith("\ufeff"):
        bom, text = "\ufeff", text[1:]

    # ValueError is a string literal json itself will not decode, and RecursionError
    # a file nested deeper than the scanner recurses. Neither is a reason for a
    # traceback, and neither message is passed on: both carry the text.
    try:
        doc, root = parse(text)
    except Bad as exc:
        sys.stderr.write("jsonc-edit: %s: %s\n" % (path, exc))
        return 1
    except (ValueError, RecursionError):
        sys.stderr.write("jsonc-edit: %s: not readable JSONC, or nested too deeply\n" % path)
        return 1
    if not isinstance(doc, dict):
        sys.stderr.write("jsonc-edit: %s is not a JSON object\n" % path)
        return 1

    if mode == "read":
        # ASCII out, so a string the file spells as a lone surrogate escape reaches
        # the caller as that escape rather than ending this in an encoding error.
        emit(json.dumps(descend(doc, scope) or {}, ensure_ascii=True))
        return 0

    updates = {k: (payload[k] if k in payload else DELETE) for k in manages}
    if not updates:
        emit(bom + text)
        return 0

    try:
        new_text = apply_all(text, scope, updates, detect_indent(text))
        # Nothing leaves here that has not been read back. The new text has to parse
        # — commas and all — and has to say exactly what the old one said with the
        # updates made, at the scope and nowhere else. A splice that got any of that
        # wrong is a refusal, never a config written over the user's own.
        got, _ = parse(new_text)
    except Bad as exc:
        sys.stderr.write("jsonc-edit: %s: the edit could not be made safely (%s)\n" % (path, exc))
        return 1
    except (ValueError, RecursionError):
        sys.stderr.write("jsonc-edit: %s: the edit could not be made safely\n" % path)
        return 1
    if got != expected_document(doc, scope, updates):
        sys.stderr.write("jsonc-edit: %s: the edit did not read back as intended; "
                         "nothing was written\n" % path)
        return 1
    try:
        out = (bom + new_text).encode("utf-8")
    except UnicodeEncodeError:
        sys.stderr.write("jsonc-edit: the payload holds text that is not valid Unicode\n")
        return 1
    sys.stdout.buffer.write(out)
    sys.stdout.buffer.flush()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        # Whoever was reading the result has gone, so there is nobody to tell, and
        # the write over a config that depended on it has already failed upstream.
        # Python flushes stdout again on the way out; pointing it at /dev/null first
        # keeps that second failure from printing a traceback of its own.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
