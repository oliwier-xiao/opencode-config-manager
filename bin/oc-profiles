#!/usr/bin/env bash
# oc-profiles — the only thing that writes an opencode config file; the panel only
# reads. jq only ever assigns the keys named in `manages`, so providers, MCP servers,
# plugin lists and API keys come out the other side byte-equal.
# Exit codes: 0 ok. 1 usage. 2 refused, nothing written. 3 partial write, all restored.

set -uo pipefail

# Opening a FIFO blocks inside open(2), before any check can run, and nothing here
# legitimately takes half a minute, so the run is bounded from the outside rather
# than guessed at from the inside. The panel already treats any other exit as a crash.
if [ "${OC_TIMEBOXED:-0}" != 1 ] && command -v timeout >/dev/null 2>&1; then
  export OC_TIMEBOXED=1
  exec timeout -k 2 30 "$0" "$@"
fi

VERSION="1.3.0"
PLUGIN_ID="oliwier.opencode-configs"

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
CACHE="$CACHE_HOME/omarchy/$PLUGIN_ID"

CFG_DIR="${OPENCODE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"
DEFAULT_CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"

# oh-my-openagent 4.x keeps its user config outside the opencode config dir, in
# ~/.omo, and shares one file across harnesses. OMO_CONFIG_HOME is here so a test
# can point the whole omo half somewhere disposable.
OMO_DIR="${OMO_CONFIG_HOME:-$HOME/.omo}"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JSONC="$SELF_DIR/jsonc-edit"

# A profile only makes sense for the config it was captured from, so a non-default
# CFG_DIR gets its own store; the default folder keeps the plain path it always had.
STATE="$STATE_HOME/omarchy/opencode-configs"
if [ "$CFG_DIR" != "$DEFAULT_CFG_DIR" ]; then
  STATE="$STATE/by-config/$(printf '%s' "$CFG_DIR" | sha256sum | cut -c1-12)"
fi

PROFILES="$STATE/profiles.json"
BACKUPS="$STATE/backups"
HOME_CFG="$HOME/.opencode/opencode.json"
AUTH_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json"

# Settings arrive as environment so the panel and a terminal drive the same code.
OC_MANAGE_OHMY="${OC_MANAGE_OHMY:-1}"
OC_MANAGE_OPENCODE="${OC_MANAGE_OPENCODE:-1}"
OC_AUTO_RELOAD="${OC_AUTO_RELOAD:-1}"
OC_BACKUPS_KEEP="${OC_BACKUPS_KEEP:-10}"
# Settings arrive from a JSON file a hand can edit. A count that is not a number, or
# is zero, would either loop or delete the copy an undo needs.
case "$OC_BACKUPS_KEEP" in
  ''|*[!0-9]*) OC_BACKUPS_KEEP=10 ;;
  *) [ "$OC_BACKUPS_KEEP" -ge 1 ] 2>/dev/null || OC_BACKUPS_KEEP=1
     [ "$OC_BACKUPS_KEEP" -le 200 ] 2>/dev/null || OC_BACKUPS_KEEP=200 ;;
esac

# The keys each shape lets a profile own. Nothing outside these lists is ever
# assigned, deleted, or reordered.
# `fallback_models` is a top-level key on the legacy oh-my-openagent.json only. The
# unified config's `[opencode]` block has no such field, and writing it there costs the
# plugin its startup: `doctor` reports
# `Unknown config key: fallback_models / Affects: plugin startup`.
# Per-agent and per-category `fallback_models` stay legal in both — this is the
# file-level key, which is a different thing that happens to share a name.
OHMY_KEYS='["agents","categories","fallback_models"]'
OHMY_KEYS_UNIFIED='["agents","categories"]'
OPENCODE_KEYS='["model","small_model","agent"]'

# An oh-my-openagent agent entry is a plain zod object, so an unknown key is stripped
# rather than rejected: the write succeeds, the config validates, and the key is simply
# not there. `models` is the one that matters. oh-my-openagent's own 4.19 migration
# rewrites `model` + `fallback_models` into a `models` array, but the schema behind the
# `[opencode]` block has no `models` field, so every agent it touches loses its pin and
# `doctor` reports `Unknown config key: agents.<name>.models / Affects: plugin startup`.
# A profile must not write the same shape. `provider` is refused for the same reason:
# no such field, silently dropped.
# `reasoning` and `displayName` are NOT refused — both are real fields on an agent entry.
# `reasoning` is the current spelling of `variant`, and is what a config migrated by
# oh-my-openagent itself will contain.
OHMY_FORBIDDEN_AGENT='["models","provider"]'
# A category is not an agent. oh-my-openagent's CategoryConfigSchema does declare
# `models`, so refusing it there refused a key the software accepts, and said so with
# a reason that was only ever true of agents. `provider` is on neither schema.
OHMY_FORBIDDEN_CATEGORY='["provider"]'

# ---------------------------------------------------------------- plumbing

# Every temporary this script makes is registered here and removed on the way out,
# including on the SIGTERM the timebox sends. cmd_detect's projections hold whole
# config documents — provider keys and MCP bearer tokens among them — and a killed
# run must not leave those sitting in /tmp.
# By prefix, not by array: mktemp_tracked is called inside $( ), and a subshell's
# appends never reach the parent — an array here would leave the trap cleaning
# nothing while appearing to work.
OC_RUN_TAG="$$-$(date +%s 2>/dev/null || echo 0)"
OC_TEMP_PREFIX=""   # set by mktemp_tracked on first use
cleanup_temps() {
  [ -n "$OC_TEMP_PREFIX" ] && rm -f "$OC_TEMP_PREFIX"* 2>/dev/null
  return 0
}
# A switch is all of itself or none of it, and the timebox can end this process in
# the middle of one. The in-process rollback cannot run once bash is dead, so the
# same restore is registered here: the backup directory and the files written so
# far, put back before the signal is honoured. Cleared once the switch has landed.
OC_ROLLBACK_DIR=""
OC_ROLLBACK_WROTE=()
rollback_writes() {
  [ -n "$OC_ROLLBACK_DIR" ] || return 0
  [ "${#OC_ROLLBACK_WROTE[@]}" -gt 0 ] || return 0
  local l
  for l in "${OC_ROLLBACK_WROTE[@]}"; do
    [ -n "$l" ] || continue
    [ -s "$OC_ROLLBACK_DIR/$l.json" ] || continue
    "$SELF_DIR/safe-read" "$OC_ROLLBACK_DIR/$l.json" --max-bytes "$MAX_BACKUP_BYTES" \
      --label "that backup" 2>/dev/null | atomic_write "$(file_for "$l")" 2>/dev/null || true
  done
  OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()
  return 0
}
on_signal() { rollback_writes; cleanup_temps; exit 143; }
trap cleanup_temps EXIT
trap on_signal INT TERM HUP

# Under $CACHE where possible rather than a shared /tmp, and 0600 either way.
mktemp_tracked() {
  mkdir -p -m 700 "$CACHE" 2>/dev/null || true
  OC_TEMP_PREFIX="$CACHE/.stage.$OC_RUN_TAG."
  mktemp "${OC_TEMP_PREFIX}XXXXXXXX" 2>/dev/null
}

die()  { printf '%s\n' "$*" >&2; exit 1; }
warn() { printf '%s\n' "$*" >&2; }

# Every failure the panel can act on comes back as JSON on stdout, so the
# difference between "refused" and "crashed" is never a guess.
refuse() {
  local code="$1"; shift
  jq -cn --arg code "$code" --arg message "$*" \
    '{ok:false, code:$code, message:$message}'
  exit 2
}

need() { command -v "$1" >/dev/null 2>&1 || die "oc-profiles: $1 is required"; }

now_iso()  { date -u +%Y-%m-%dT%H:%M:%SZ; }
now_stamp(){ date -u +%Y-%m-%dT%H-%M-%SZ; }

# The stamp has one-second resolution and an undo lands well inside one second: without
# a unique name the revert's own backup overwrites the copy it is about to restore from.
new_backup_stamp() {
  local base suffix candidate
  base="$(now_stamp)"
  candidate="$base"
  suffix=2
  while [ -e "$BACKUPS/$candidate" ] && [ "$suffix" -lt 100 ]; do
    candidate="$base-$suffix"
    suffix=$((suffix + 1))
  done
  printf '%s' "$candidate"
}

# A projection of only the managed keys, key-sorted so the digest does not move
# when a file is reformatted or its keys reordered by hand.
fingerprint() {
  local file="$1" keys="$2"
  [ -r "$file" ] || { printf 'sha256:absent'; return 0; }
  local fp
  fp=$(jq -S -c --argjson m "$keys" \
        '. as $in | reduce $m[] as $k ({}; if ($in|has($k)) then .[$k]=$in[$k] else . end)' \
        "$file" 2>/dev/null | sha256sum 2>/dev/null | cut -c1-16)
  [ -n "$fp" ] || fp="unreadable"
  printf 'sha256:%s' "$fp"
}

# fingerprint() over whatever a logical target actually contributes, which for the
# unified omo config is one key deep rather than the whole file.
fingerprint_logical() {
  local logical="$1" doc
  doc="$(read_projected "$logical")"
  [ -n "$doc" ] && [ "$doc" != "null" ] || { printf 'sha256:absent'; return 0; }
  payload_fingerprint "$doc" "$(keys_for "$logical")"
}

# The first saved profile whose every target matches what is on disk, or an empty
# string. This is the same question cmd_list answers for the panel, asked here so a
# command that has just rewritten the config can record what it landed on rather
# than leaving the store saying nothing is active.
matching_profile_id() {
  local ohmy_fp opencode_fp
  ohmy_fp="$(fingerprint_logical ohmy)"
  opencode_fp="$(fingerprint_logical opencode)"
  store_jq -r --arg ohmy "$ohmy_fp" --arg opencode "$opencode_fp" '
    [ .profiles[]
      | select( (.targets // [])
                | length > 0
                and ( map( .fingerprint == (if .file == "ohmy" then $ohmy else $opencode end) )
                      | all ) )
      | .id ] | .[0] // ""' 2>/dev/null || printf ''
}

# fingerprint() over a profile's stored payload instead of a file. It must project
# through `manages` the same way, or a profile never matches the file it came from.
payload_fingerprint() {
  local payload="$1" keys="$2"
  local fp
  fp=$(printf '%s' "$payload" | jq -S -c --argjson m "$keys" \
        '. as $in | reduce $m[] as $k ({}; if ($in|has($k)) then .[$k]=$in[$k] else . end)' \
        2>/dev/null | sha256sum 2>/dev/null | cut -c1-16)
  [ -n "$fp" ] || fp="unreadable"
  printf 'sha256:%s' "$fp"
}

# Temp file in the same directory, then rename(2): a reader sees the whole old file or
# the whole new one, never a truncated config opencode may be reading as we write it.
# atomic_write <dest> [--no-follow]
#
# A thin front for bin/safe-write, which does the part bash cannot: an O_EXCL,
# O_NOFOLLOW, 0600 temporary in the destination's own directory, fsync, rename, and
# an fsync of the directory so the rename is durable too.
#
# A config is followed by default: renaming over the link itself would detach a
# dotfiles-managed file from whatever manages it, and following is what the user
# asked for by making it a link. --no-follow is for anything this plugin owns at a
# path anything running as this user can predict, where a link planted at the name
# would turn the write into a write somewhere else entirely.
atomic_write() {
  local dest="$1" mode="${2:-}"
  if [ "$mode" = "--no-follow" ]; then
    "$SELF_DIR/safe-write" "$dest"
  else
    "$SELF_DIR/safe-write" "$dest" --follow
  fi
}

# The store sits in a directory anything running as this user can write, and `list`
# hands it to a panel living inside omarchy-shell — one process for the whole
# desktop. So it is judged on the descriptor that will be read rather than on its
# name: a name checked and then opened is a name that can be replaced in between.
MAX_STORE_BYTES=2097152

# The rest of what this reads, and what it will not read more than. auth.json is
# only ever mined for key *names*, the home config for three keys, and the
# oh-my-openagent bundle for a roster — but all four sit at predictable paths that
# anything running as this user can write, so all four are bounded and read through
# bin/safe-read rather than handed to jq or python by name.
MAX_AUTH_BYTES=1048576
MAX_CONFIG_BYTES=4194304
MAX_BACKUP_BYTES=4194304
# The bundle really is this big: 4.19.3 ships a 5.5 MB dist/index.js.
MAX_PACKAGE_BYTES=67108864

# Whatever this prints ends up buffered whole inside omarchy-shell before the panel
# gets a chance to measure it, so the two commands whose output grows with a file
# somebody else wrote are capped here, at the end they come out of.
MAX_EMIT_BYTES=4194304

# Every file this shell reads goes through bin/safe-read: one open with O_NOFOLLOW
# and O_NONBLOCK, every decision taken on that descriptor rather than on the name,
# and exactly the bytes that were vouched for read back through it. A name checked
# and then opened is a name that can be replaced in between — and a FIFO planted at
# the path stalls inside open(2), where no check can run and only a timeout helps.
# Because the name is resolved exactly once there is nothing left to race, and so
# nothing here to retry.
#
# Exit: 0 printed it, 1 nothing there, 2 refused, 3 could not read it.
read_store() {
  "$SELF_DIR/safe-read" "$PROFILES" --max-bytes "$MAX_STORE_BYTES" --label "the profile store"
}

# Anything else this reads, into a temporary file the caller then points a tool at.
# Prints the path on success and nothing on failure; the file is the caller's to
# remove. --follow because these are the user's own files, which people symlink out
# of dotfiles repositories on purpose; the descriptor check still refuses a FIFO, a
# device or an oversized file, so what following costs is only the guarantee about
# which regular file was read.
read_capped() {
  local path="$1" cap="$2" label="$3" tmp
  tmp="$(mktemp_tracked)" || return 1
  if "$SELF_DIR/safe-read" "$path" --max-bytes "$cap" --follow --label "$label" > "$tmp" 2>/dev/null; then
    printf '%s' "$tmp"; return 0
  fi
  rm -f "$tmp"; return 1
}

# jq is never pointed at the store's path. It is fed what the reader vouched for,
# so a store swapped between two commands cannot be parsed by one of them.
store_jq() {
  local raw rc=0
  raw="$(read_store)" || rc=$?
  [ "$rc" = 0 ] || return "$rc"
  printf '%s' "$raw" | jq "$@"
}

EMPTY_STORE='{"version":1,"state":{"activeProfileId":null,"appliedAt":null,"lastBackup":null,"previousProfileId":null},"favorites":[],"recents":[],"profiles":[]}'

# `>` would follow a symlink and create, or truncate, whatever it points at — and a
# dangling one looks exactly like "no store yet". link(2) does not follow the name it
# is creating, so anything already sitting there is an error rather than a target.
create_store() {
  local tmp
  tmp="$(mktemp "$STATE/.profiles.json.XXXXXXXX" 2>/dev/null)" || return 1
  printf '%s\n' "$EMPTY_STORE" > "$tmp" || { rm -f "$tmp"; return 1; }
  ln "$tmp" "$PROFILES" 2>/dev/null || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
}

ensure_state() {
  mkdir -p "$STATE" "$BACKUPS" "$CACHE" 2>/dev/null || true
  local raw rc=0
  raw="$(read_store)" || rc=$?
  case "$rc" in
    0) # A zero-length store is an interrupted write, not a store. atomic_write
       # renames into place, so this never writes through the name either.
       [ -n "$raw" ] || printf '%s\n' "$EMPTY_STORE" | atomic_write "$PROFILES" --no-follow \
         || refuse "E_STORE" "Could not initialise the profile store." ;;
    1) create_store \
         || refuse "E_STORE" "Could not create the profile store. Something else is at $PROFILES." ;;
    *) refuse "E_STORE" "The profile store is not a plain file, or is too large to read." ;;
  esac
}

# One writer at a time: two switches racing is a user pressing twice, so the second is
# refused rather than queued. The lock is the state directory itself, opened read-only:
# flock works on any descriptor, and a directory cannot be swapped for a symlink to
# somebody's file the way a .lock beside the store can — that open truncates.
take_lock() {
  # Fail closed. Returning success when the directory cannot be opened would run
  # the whole switch believing it held a lock it never took.
  exec 9<"$STATE" || refuse "E_STORE" "Cannot open the profile directory to lock it."
  flock -n 9 || refuse "E_BUSY" "Another switch is already running."
}

# ---------------------------------------------------------------- resolution

# The first path that exists wins, matching the loader's own order.
#
# oh-my-openagent 4.x resolves its user config to ~/.omo/omo.jsonc. The four names
# under the opencode config dir are what its one-shot "2026-07-opencode-config-
# unification" migration reads *from*: once that migration has run, writing to them
# changes nothing anyone reads. They stay in the list so a machine that has not
# upgraded yet is still editable, but they come second.
resolve_ohmy() {
  local p
  for p in "$OMO_DIR/omo.jsonc" "$OMO_DIR/omo.json"; do
    [ -f "$p" ] && { printf '%s' "$p"; return; }
  done
  for p in "$CFG_DIR/oh-my-openagent.jsonc" "$CFG_DIR/oh-my-openagent.json" \
           "$CFG_DIR/oh-my-opencode.jsonc"  "$CFG_DIR/oh-my-opencode.json"; do
    [ -f "$p" ] && { printf '%s' "$p"; return; }
  done
  printf '%s' "$OMO_DIR/omo.jsonc"
}

# The unified config carries one harness per key, so the opencode half of it sits
# under "[opencode]" rather than at the top level. The legacy per-harness files
# have no wrapper. Everything downstream reads and writes through this projection,
# which is why the rest of the script never has to know which shape it got.
scope_for() {
  case "$1" in
    ohmy)
      case "$(resolve_ohmy)" in
        "$OMO_DIR"/*) printf '%s' '["[opencode]"]' ;;
        *)            printf '%s' '[]' ;;
      esac
      ;;
    *) printf '%s' '[]' ;;
  esac
}

# Where opencode unpacks a plugin. Not $CACHE_HOME/opencode/node_modules — that
# path has never existed on any install; every plugin gets its own directory named
# after the spec it was requested by.
omo_package_dir() {
  local d best="" best_v="" v
  # Every spec the plugin was ever requested by leaves a directory behind, and they
  # accumulate: an `@latest` beside a bare one beside a pinned `@4.20`. A glob hands
  # those back in lexicographic order, which put a long-abandoned 4.13 ahead of the
  # 4.19 actually loaded. The roster has to come off the newest one present, and the
  # bare directory — which the old pattern could not even match — counts too.
  for d in "$CACHE_HOME"/opencode/packages/oh-my-openagent*/node_modules/oh-my-openagent \
           "$CACHE_HOME"/opencode/packages/oh-my-opencode*/node_modules/oh-my-opencode; do
    [ -f "$d/package.json" ] || continue
    v="$(jq -r '.version // empty' "$d/package.json" 2>/dev/null)"
    [ -n "$v" ] || continue
    if [ -z "$best" ] || [ "$(printf '%s\n%s\n' "$best_v" "$v" | sort -V | tail -1)" = "$v" ]; then
      best="$d"; best_v="$v"
    fi
  done
  [ -n "$best" ] && printf '%s' "$best"
  return 0
}

# The rosters come off the installed software, never out of this file. opencode
# names its agents in its own generated schema; oh-my-openagent ships a JSON Schema
# naming its agents and carries the category names as an enum in its bundle. A
# panel that guessed instead eventually offers somebody an agent that never existed
# — and then writes it into their config.
#
# Both probes are slow enough to be worth caching, and the cache key is the two
# versions, so an upgrade re-reads rather than serving yesterday's roster.
roster_json() {
  local pkg="$1" oc_version="$2" omo_version="$3"
  local key cache_file oc_agents om_agents om_cats
  key="$(printf '%s|%s' "$oc_version" "$omo_version" | sha256sum | cut -c1-16)"
  cache_file="$CACHE/roster-$key.json"
  # Read like everything else: through the descriptor, bounded, and refused if it
  # is not a plain file this user owns. It sits next to the model cache, which
  # bin/read-catalog goes to the same trouble over.
  local cached
  if cached="$("$SELF_DIR/safe-read" "$cache_file" --max-bytes "$MAX_STORE_BYTES" \
                 --no-empty --label "the roster cache" 2>/dev/null)"; then
    if printf '%s' "$cached" | jq -e . >/dev/null 2>&1; then printf '%s' "$cached"; return 0; fi
  fi

  # `opencode generate` is the slowest thing detect does and the outer timebox is
  # the whole command's budget, not this one probe's. Bounding it here means a
  # hung opencode costs a roster, not the panel.
  local probed_oc=0
  oc_agents="$(command -v opencode >/dev/null 2>&1 \
    && timeout 10 opencode generate 2>/dev/null | head -c "$MAX_PACKAGE_BYTES" \
       | jq -c '[.components.schemas.Config.properties.agent.properties | keys[]]' 2>/dev/null)"
  case "$oc_agents" in
    ''|null) oc_agents='[]' ;;
    *) probed_oc=1 ;;
  esac

  om_agents='[]'; om_cats='[]'
  if [ -n "$pkg" ]; then
    local schema_f bundle_f
    schema_f="$(read_capped "$pkg/dist/oh-my-opencode.schema.json" "$MAX_PACKAGE_BYTES" "the oh-my-openagent schema")" || schema_f=""
    if [ -n "$schema_f" ]; then
      om_agents="$(jq -c '[.properties.agents.properties | keys[]]' "$schema_f" 2>/dev/null)"
      rm -f "$schema_f"
    fi
    case "$om_agents" in ''|null) om_agents='[]' ;; esac
    bundle_f="$(read_capped "$pkg/dist/index.js" "$MAX_PACKAGE_BYTES" "the oh-my-openagent bundle")" || bundle_f=""
    om_cats="$(python3 - "${bundle_f:-/dev/null}" <<'PYEOF'
import json, re, sys
try:
    with open(sys.argv[1], encoding="utf-8", errors="replace") as fh:
        blob = fh.read()
except OSError:
    print("[]"); raise SystemExit
# The bundle is minified onto few lines, so this has to match across newlines.
m = re.search(r"BuiltinCategoryNameSchema\s*=\s*[A-Za-z_$][\w$]*\.enum\(\s*\[(.*?)\]\s*\)", blob, re.S)
print(json.dumps(re.findall(r'"([^"]+)"', m.group(1)) if m else []))
PYEOF
)"
    [ -n "$bundle_f" ] && rm -f "$bundle_f"
    case "$om_cats" in ''|null) om_cats='[]' ;; esac
  fi

  local out
  out="$(jq -cn --argjson oca "$oc_agents" --argjson oma "$om_agents" --argjson omc "$om_cats" \
    '{opencode:{agents:$oca}, ohmy:{agents:$oma, categories:$omc}}')"
  # Only memoise a probe that actually answered. Caching "I could not ask" pins the
  # panel to an empty roster until one of the two versions moves, which for a
  # transient failure could be weeks. --no-follow: this is the plugin's own file at
  # a predictable path, and a link planted there would redirect the write.
  if [ "$probed_oc" = 1 ] && [ -n "$pkg" ] && [ "$om_agents" != '[]' ]; then
    mkdir -p "$CACHE" 2>/dev/null \
      && printf '%s\n' "$out" | atomic_write "$cache_file" --no-follow 2>/dev/null || true
  elif [ "$probed_oc" = 1 ] && [ -z "$pkg" ]; then
    mkdir -p "$CACHE" 2>/dev/null \
      && printf '%s\n' "$out" | atomic_write "$cache_file" --no-follow 2>/dev/null || true
  fi
  printf '%s' "$out"
}

# `jsonc-edit read`, with the scope keys spread onto the command line.
read_projected() {
  local logical="$1" file scope k
  file="$(file_for "$logical")"
  [ -f "$file" ] || { printf 'null'; return 0; }
  scope="$(scope_for "$logical")"
  local args=(read "$file")
  while IFS= read -r k; do [ -n "$k" ] && args+=(--scope "$k"); done < <(printf '%s' "$scope" | jq -r '.[]?')
  "$JSONC" "${args[@]}" 2>/dev/null || printf 'null'
}

# The write half of the same projection: prints the whole new file on stdout, with
# every comment and every key this tool does not manage left exactly as it was.
write_projected() {
  local logical="$1" payload="$2" mkeys="$3" file scope k
  file="$(file_for "$logical")"
  scope="$(scope_for "$logical")"
  local args=(apply "$file" --payload "$payload" --manages "$mkeys")
  while IFS= read -r k; do [ -n "$k" ] && args+=(--scope "$k"); done < <(printf '%s' "$scope" | jq -r '.[]?')
  "$JSONC" "${args[@]}"
}

resolve_opencode() {
  local p
  for p in "$CFG_DIR/opencode.jsonc" "$CFG_DIR/opencode.json" "$CFG_DIR/config.json"; do
    [ -f "$p" ] && { printf '%s' "$p"; return; }
  done
  printf '%s' "$CFG_DIR/opencode.json"
}

file_for() {
  case "$1" in
    ohmy)     resolve_ohmy ;;
    opencode) resolve_opencode ;;
    *)        die "oc-profiles: unknown target '$1'" ;;
  esac
}

keys_for() {
  case "$1" in
    ohmy)     if [ "$(scope_for ohmy)" = '[]' ]
              then printf '%s' "$OHMY_KEYS"
              else printf '%s' "$OHMY_KEYS_UNIFIED"
              fi ;;
    opencode) printf '%s' "$OPENCODE_KEYS" ;;
  esac
}

managed() {
  case "$1" in
    ohmy)     [ "$OC_MANAGE_OHMY" = 1 ] ;;
    opencode) [ "$OC_MANAGE_OPENCODE" = 1 ] ;;
  esac
}

# Managed *and* actually present. A profile carrying an oh-my-openagent half is
# still worth applying on a machine that only runs opencode — the half that has a
# file lands, the other is reported as skipped. Refusing the whole switch over a
# file the user does not have is how a profile becomes permanently un-appliable.
applicable() {
  local logical="$1"
  managed "$logical" || return 1
  if [ "$logical" = "ohmy" ] && [ ! -f "$(file_for "$logical")" ]; then return 1; fi
  return 0
}


# ---------------------------------------------------------------- detect

# Everything the panel needs to draw itself before the user touches anything. Only key
# *names* are ever read out of auth.json — this file prints no secret.
cmd_detect() {
  ensure_state
  local ohmy opencode
  ohmy="$(resolve_ohmy)"
  opencode="$(resolve_opencode)"

  local oc_version omo_version omo_pkg
  oc_version="$(command -v opencode >/dev/null 2>&1 && opencode --version 2>/dev/null | tr -d '\r' || true)"
  omo_pkg="$(omo_package_dir)"
  omo_version="$([ -n "$omo_pkg" ] && jq -r '.version // ""' "$omo_pkg/package.json" 2>/dev/null || true)"

  local authed
  local auth_f; auth_f="$(read_capped "$AUTH_FILE" "$MAX_AUTH_BYTES" "the opencode auth file")" || auth_f=""
  authed='[]'
  if [ -n "$auth_f" ]; then
    authed="$(jq -c '[keys[]]' "$auth_f" 2>/dev/null || printf '[]')"
    rm -f "$auth_f"
  fi

  # Built without a pipeline: under `set -o pipefail` a pgrep that matches nothing fails
  # the whole pipe, the `||` fallback fires on top of jq's own `[]`, and detect emits `[][]`.
  local pids pid_list=""
  for pid in $(pgrep -x opencode 2>/dev/null); do
    pid_list="${pid_list:+$pid_list,}$pid"
  done
  pids="[$pid_list]"

  # A project-level config shadows the user one, and editing the user file then has
  # no visible effect. Worth a warning rather than a silent no-op. oh-my-openagent
  # walks cwd upwards looking for .omo, nearest wins; opencode does the same with
  # .opencode. Both are worth reporting, and neither used to be found.
  local shadows='[]' probe="$PWD"
  while :; do
    # $HOME is where the user layer lives, so a hit there is the config itself
    # rather than something shadowing it. Only the directories below it count.
    if [ "$probe" != "$HOME" ]; then
      if [ -f "$probe/.omo/omo.jsonc" ] || [ -f "$probe/.omo/omo.json" ]; then
        shadows="$(printf '%s' "$shadows" | jq -c --arg d "$probe/.omo" '. + [$d]')"
      fi
      if [ -f "$probe/.opencode/opencode.json" ] || [ -f "$probe/.opencode/opencode.jsonc" ]; then
        shadows="$(printf '%s' "$shadows" | jq -c --arg d "$probe/.opencode" '. + [$d]')"
      fi
    fi
    case "$probe" in "$HOME"|/|"") break ;; esac
    probe="$(dirname "$probe")"
  done

  # Is oh-my-openagent actually in play? Three independent signals, because each
  # one alone is wrong for somebody: the package can be installed and unused, the
  # plugin can be declared before its config exists, and a config file can be left
  # behind by an uninstall. A leftover file on its own is reported, not obeyed.
  local opencode_doc omo_declared=false omo_installed=false omo_configured=false
  opencode_doc="$(read_projected opencode)"
  if printf '%s' "$opencode_doc" | jq -e '
        [ (.plugin // [])[] | if type == "array" then .[0] else . end ]
        | map(select(type == "string"))
        | any(test("(^|/)oh-my-open(agent|code)($|@)"))' >/dev/null 2>&1; then
    omo_declared=true
  fi
  [ -n "$omo_pkg" ] && omo_installed=true
  [ -f "$ohmy" ] && omo_configured=true

  local omo_active=false
  if [ "$omo_declared" = true ] || [ "$omo_installed" = true ]; then omo_active=true; fi

  local roster; roster="$(roster_json "$omo_pkg" "$oc_version" "$omo_version")"

  # The projections go to files rather than onto the command line: a config can
  # hold provider keys and an MCP bearer token, and /proc makes an argv public.
  local ohmy_doc_f opencode_doc_f home_doc_f home_src
  ohmy_doc_f="$(mktemp_tracked)"; read_projected ohmy > "$ohmy_doc_f"
  opencode_doc_f="$(mktemp_tracked)"; printf '%s' "$opencode_doc" > "$opencode_doc_f"
  home_doc_f="$(mktemp_tracked)"; printf 'null' > "$home_doc_f"
  home_src="$(read_capped "$HOME_CFG" "$MAX_CONFIG_BYTES" "the ~/.opencode config")" || home_src=""
  if [ -n "$home_src" ]; then
    jq -e . "$home_src" >/dev/null 2>&1 && cp -f "$home_src" "$home_doc_f"
    rm -f "$home_src"
  fi

  jq -n \
    --arg ohmyPath "$ohmy" \
    --arg ohmyScope "$(scope_for ohmy)" \
    --arg opencodePath "$opencode" \
    --arg homePath "$HOME_CFG" \
    --arg ohmyFp "$(fingerprint_logical ohmy)" \
    --arg opencodeFp "$(fingerprint_logical opencode)" \
    --argjson roster "$roster" \
    --argjson omoActive "$omo_active" \
    --argjson omoDeclared "$omo_declared" \
    --argjson omoInstalled "$omo_installed" \
    --argjson omoConfigured "$omo_configured" \
    --arg ocVersion "$oc_version" \
    --arg omoVersion "$omo_version" \
    --argjson authed "$authed" \
    --argjson pids "$pids" \
    --argjson shadows "$shadows" \
    --argjson ohmyExists "$([ -f "$ohmy" ] && echo true || echo false)" \
    --argjson opencodeExists "$([ -f "$opencode" ] && echo true || echo false)" \
    --argjson homeExists "$([ -f "$HOME_CFG" ] && echo true || echo false)" \
    --argjson ohmyParses "$([ -f "$ohmy" ] && [ "$(read_projected ohmy)" != "null" ] && echo true || echo false)" \
    --argjson opencodeParses "$([ -f "$opencode" ] && [ "$opencode_doc" != "null" ] && echo true || echo false)" \
    --argjson ohmyWritable "$([ -w "$ohmy" ] || [ ! -e "$ohmy" ] && [ -w "$(dirname "$ohmy")" ] && echo true || echo false)" \
    --argjson opencodeWritable "$([ -w "$opencode" ] || [ ! -e "$opencode" ] && [ -w "$(dirname "$opencode")" ] && echo true || echo false)" \
    --slurpfile ohmyDocA "$ohmy_doc_f" \
    --slurpfile opencodeDocA "$opencode_doc_f" \
    --slurpfile homeDocA "$home_doc_f" \
    '
    ( $ohmyDocA[0]     // null ) as $ohmyDoc     |
    ( $opencodeDocA[0] // null ) as $opencodeDoc |
    ( $homeDocA[0]     // null ) as $homeDoc     |
    def fmt(p): if (p|endswith(".jsonc")) then "jsonc" else "json" end;
    {
      ok: true,
      # Which half of the panel is real. A config file left behind by an uninstall
      # is not evidence the plugin runs, so the shape follows the software: an
      # oh-my-openagent that opencode actually loads, or plain opencode.
      shape: (if $omoActive then "oh-my-openagent" else "opencode" end),
      ohMy: {
        active: $omoActive,
        declaredInOpencodeJson: $omoDeclared,
        installed: $omoInstalled,
        configured: $omoConfigured,
        # A config nobody loads. Worth saying out loud rather than acting on.
        stale: ($omoConfigured and ($omoActive | not))
      },
      roster: $roster,
      opencodeVersion: $ocVersion,
      ohMyVersion: $omoVersion,
      authedProviders: $authed,
      running: { pids: $pids, count: ($pids|length) },
      files: {
        ohmy: {
          path: $ohmyPath, exists: $ohmyExists, format: fmt($ohmyPath),
          # "" for a legacy per-harness file, "[opencode]" for the unified one.
          scope: ($ohmyScope | fromjson | join(".")),
          parses: $ohmyParses, writable: $ohmyWritable, fingerprint: $ohmyFp,
          agents:     (($ohmyDoc.agents     // {}) | keys),
          categories: (($ohmyDoc.categories // {}) | keys),
          unmanagedTopLevelKeys:
            (($ohmyDoc // {}) | keys | map(select(. as $k | ["agents","categories","fallback_models"] | index($k) | not)))
        },
        opencode: {
          path: $opencodePath, exists: $opencodeExists, format: fmt($opencodePath),
          parses: $opencodeParses, writable: $opencodeWritable, fingerprint: $opencodeFp,
          model: ($opencodeDoc.model // null),
          smallModel: ($opencodeDoc.small_model // null),
          agentKeys: (($opencodeDoc.agent // {}) | keys),
          unmanagedTopLevelKeys:
            (($opencodeDoc // {}) | keys | map(select(. as $k | ["model","small_model","agent"] | index($k) | not)))
        },
        home: {
          path: $homePath, exists: $homeExists,
          keys: (($homeDoc // {}) | keys),
          # A model or agent key here is loaded last and beats everything this
          # plugin writes. Saying so is the whole reason the file is reported.
          overrides: (($homeDoc // {}) | keys | map(select(. == "model" or . == "agent" or . == "small_model")))
        }
      },
      warnings:
        ( (if $ohmyExists and ($ohmyParses|not) then [{code:"E_PARSE", file:$ohmyPath}] else [] end)
        + (if $opencodeExists and ($opencodeParses|not) then [{code:"E_PARSE", file:$opencodePath}] else [] end)
        + (if ($omoConfigured and ($omoActive|not)) then [{code:"W_OHMY_STALE", file:$ohmyPath}] else [] end)
        + ($shadows | map({code:"W_SHADOWED", dir:.}))
        + (($homeDoc // {}) | keys | map(select(. == "model" or . == "agent"))
             | map({code:"W_HOME_OVERRIDE", key:., file:$homePath})) )
    }' | head -c "$MAX_EMIT_BYTES"

  rm -f "$ohmy_doc_f" "$opencode_doc_f" "$home_doc_f"
}

# ---------------------------------------------------------------- validation

# Refuse before writing rather than explain after: every check here would otherwise
# produce a config that loads but silently does not do what the profile says.
preflight() {
  local logical="$1" payload="$2" file="$3"

  [ -f "$file" ] || refuse "E_MISSING" "$(basename "$file") does not exist."
  # A .jsonc used to be refused outright because jq cannot read comments. The edit
  # is a splice now, so comments survive it and the file is editable like any other.
  [ "$(read_projected "$logical")" != "null" ] \
    || refuse "E_PARSE" "$(basename "$file") will not parse. Nothing was changed."
  [ -w "$file" ] || refuse "E_PERM" "Cannot write $(basename "$file")."

  # Every model reference must look like provider/model. A typo here reaches
  # opencode as an unknown provider and takes the agent down with it.
  local bad
  bad=$(printf '%s' "$payload" | jq -r '
    [ .. | objects | select(has("model")) | .model ]
    | map(select(type=="string")) | map(select(length > 0))
    | map(select(test("^[A-Za-z0-9~._-]+(/[^/[:space:]]+)+$") | not))
    | unique | .[]' 2>/dev/null | head -1)
  [ -z "$bad" ] || refuse "E_MODEL_SYNTAX" "\"$bad\" is not a provider/model id."

  # opencode's AgentConfig is an object and its schema has no string branch, so a
  # bare model string under `agent` is a config that will not load. The panel writes
  # the long form; this is the gate that makes that a guarantee rather than a habit.
  if [ "$logical" = "opencode" ]; then
    local bare
    bare=$(printf '%s' "$payload" | jq -r '
      (.agent // {}) | to_entries | map(select(.value | type != "object")) | .[0].key // empty' 2>/dev/null)
    [ -z "$bare" ] || refuse "E_AGENT_SHAPE" \
      "\"$bare\" is set to a bare model string; opencode needs { \"model\": ... } there."
  fi

  if [ "$logical" = "ohmy" ]; then
    # Asked separately, because the answer is half the message. Merged into one list
    # the branch is lost, and a category refusal then explains itself as an agent —
    # the same wrong reason the split was made to stop giving.
    local bad_agent bad_category
    bad_agent=$(printf '%s' "$payload" | jq -r --argjson f "$OHMY_FORBIDDEN_AGENT" '
      (.agents // {}) | to_entries[] | .value | select(type=="object")
      | keys[] | select(. as $k | $f | index($k))' 2>/dev/null | head -1)
    bad_category=$(printf '%s' "$payload" | jq -r --argjson f "$OHMY_FORBIDDEN_CATEGORY" '
      (.categories // {}) | to_entries[] | .value | select(type=="object")
      | keys[] | select(. as $k | $f | index($k))' 2>/dev/null | head -1)
    # What actually happens is a strip, not a rejection: the entry survives without the
    # key, so the agent stays and its model does not. Saying it is dropped whole sends
    # people looking for a missing agent that is sitting right there.
    [ -z "$bad_agent" ] || refuse "E_FIELD_4X" \
      "This profile sets \"$bad_agent\" on an agent; oh-my-openagent has no such field and drops it on load, leaving that agent with no model. Use \"model\" and \"fallback_models\"."
    [ -z "$bad_category" ] || refuse "E_FIELD_4X" \
      "This profile sets \"$bad_category\" on a category; oh-my-openagent has no such field and drops it on load."
  fi
}

# A restore writes a whole file rather than a few keys, so it gets the same gate
# a forward write does — the one path that used to skip every check.
preflight_restore() {
  local dest="$1" src="$2"
  if [ -e "$dest" ] && [ ! -w "$dest" ]; then refuse "E_PERM" "Cannot write $(basename "$dest")."; fi
  # A backup is a byte copy of whatever the file was, comments and all, so it is
  # read back the same way the live file is.
  "$JSONC" read "$src" >/dev/null 2>&1 \
    || refuse "E_PARSE" "That backup is not readable any more."
}

# Deliberately not a pipeline stage: refuse() inside a pipeline exits only the
# subshell, and an edit that never landed would still be announced as saved.
store_update() {
  local next
  # -c, because jq's pretty-printer triples the size of the thing the reader then
  # has to fit under MAX_STORE_BYTES.
  next=$(store_jq -c "$@") || refuse "E_STORE" "Could not read the profile store."
  [ -n "$next" ] || refuse "E_STORE" "Could not update the profile store."
  printf '%s\n' "$next" | atomic_write "$PROFILES" --no-follow \
    || refuse "E_STORE" "Could not save the profile store."
}

# `manages` arrives from the store, which a hand edit can write. Unclamped it would let
# a profile assign or delete mcp, provider or plugin — the keys this design never touches.
clamp_manages() {
  printf '%s' "$1" | jq -c --argjson a "$2" 'map(select(. as $k | $a | index($k)))'
}

# ---------------------------------------------------------------- apply

cmd_apply() {
  local id="${1:-}"
  [ -n "$id" ] || die "usage: oc-profiles apply <profile-id>"
  ensure_state
  take_lock

  local profile
  profile=$(store_jq -c --arg id "$id" '.profiles[] | select(.id == $id)' 2>/dev/null)
  [ -n "$profile" ] || refuse "E_NO_PROFILE" "No profile called \"$id\"."

  local targets applied=() skipped=() stamp dir
  targets=$(printf '%s' "$profile" | jq -c '.targets[]?')
  [ -n "$targets" ] || refuse "E_EMPTY_PROFILE" "\"$id\" does not describe any config."

  # Preflight everything before touching anything. A profile that would fail on
  # its second file must not have written its first.
  local logical payload file
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    logical=$(printf '%s' "$target" | jq -r '.file')
    if ! applicable "$logical"; then skipped+=("$logical"); continue; fi
    payload=$(printf '%s' "$target" | jq -c '.payload // {}')
    file="$(file_for "$logical")"
    preflight "$logical" "$payload" "$file"
  done <<< "$targets"

  stamp="$(new_backup_stamp)"
  dir="$BACKUPS/$stamp"
  mkdir -p "$dir" || refuse "E_PERM" "Cannot create a backup directory."

  local from_id backup_files='[]'
  from_id=$(store_jq -r '.state.activeProfileId // ""')

  # Byte copies, taken before the first write: restoring is a copy back, not a
  # re-serialisation, so an undo returns the file with the user's own formatting.
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    logical=$(printf '%s' "$target" | jq -r '.file')
    applicable "$logical" || continue
    file="$(file_for "$logical")"
    cp -pL "$file" "$dir/$logical.json" || refuse "E_PERM" "Cannot back up $(basename "$file")."
    backup_files=$(jq -cn --argjson acc "$backup_files" --arg l "$logical" --arg p "$file" \
      --arg fp "$(fingerprint_logical "$logical")" \
      '$acc + [{logical:$l, path:$p, fingerprint:$fp}]')
  done <<< "$targets"

  jq -n --arg ts "$stamp" --arg from "$from_id" --arg to "$id" --argjson files "$backup_files" \
    '{ts:$ts, fromProfileId:(if $from=="" then null else $from end), toProfileId:$to, files:$files}' \
    > "$dir/meta.json"

  # Write. Any failure rolls every already-written file back from the copies
  # above, so a switch is all of itself or none of it.
  local wrote=()
  local rc=0
  OC_ROLLBACK_DIR="$dir"; OC_ROLLBACK_WROTE=()
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    logical=$(printf '%s' "$target" | jq -r '.file')
    applicable "$logical" || continue
    payload=$(printf '%s' "$target" | jq -c '.payload // {}')
    file="$(file_for "$logical")"

    # A key the profile carries is assigned, a managed key it omits is deleted — the half
    # a deep merge cannot do, and why switching away can remove an agent again.
    local mkeys
    mkeys=$(printf '%s' "$target" | jq -c --argjson d "$(keys_for "$logical")" '.manages // $d')
    mkeys=$(clamp_manages "$mkeys" "$(keys_for "$logical")")

    # Recorded before the write, not after: a write that fails part-way is
    # exactly the one the rollback has to cover.
    wrote+=("$logical"); OC_ROLLBACK_WROTE+=("$logical")
    if ! write_projected "$logical" "$payload" "$mkeys" | atomic_write "$file"; then
      rc=1; break
    fi
    if [ "$(read_projected "$logical")" = "null" ]; then rc=1; break; fi
    applied+=("$logical")
  done <<< "$targets"

  if [ "$rc" -ne 0 ]; then
    local l
    # atomic_write, not `cp`: cp truncates and then streams, so a signal landing
    # inside it leaves a half-written config — the one outcome this design exists
    # to prevent, arriving on the path taken when things have already gone wrong.
    for l in "${wrote[@]:-}"; do
      [ -n "$l" ] || continue
      "$SELF_DIR/safe-read" "$dir/$l.json" --max-bytes "$MAX_BACKUP_BYTES" --label "that backup" \
        2>/dev/null | atomic_write "$(file_for "$l")" 2>/dev/null || true
    done
    OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The write failed and the previous config was put back.", backup:$backup}'
    exit 3
  fi

  # Past here the configs on disk are the ones the profile asked for, so a signal
  # must not put the previous ones back over them.
  OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()

  # Stamp the store with fresh fingerprints read back off the files we just
  # wrote, so drift is measured against reality rather than against intent.
  local new_targets='[]' l fp
  for l in "${applied[@]:-}"; do
    [ -n "$l" ] || continue
    fp="$(fingerprint_logical "$l")"
    new_targets=$(jq -cn --argjson acc "$new_targets" --arg l "$l" --arg fp "$fp" '$acc + [{file:$l, fingerprint:$fp}]')
  done

  store_update --arg id "$id" --arg from "$from_id" --arg at "$(now_iso)" --arg backup "$stamp" \
     --argjson fps "$new_targets" '
     .state.previousProfileId = (if $from == "" then null else $from end)
   | .state.activeProfileId = $id
   | .state.appliedAt = $at
   | .state.lastBackup = $backup
   | .profiles = ( .profiles | map(
       if .id == $id then
         .targets = ( .targets | map( . as $t
           | ([$fps[] | select(.file == $t.file) | .fingerprint] | first) as $fp
           | if $fp then .fingerprint = $fp else . end ) )
       else . end ) )
   '

  prune_backups

  local reloaded=0
  if [ "$OC_AUTO_RELOAD" = 1 ]; then reload_opencode && reloaded=1; fi

  jq -cn --argjson applied "$(printf '%s\n' "${applied[@]:-}" | jq -R . | jq -sc 'map(select(length>0))')" \
         --argjson skipped "$(printf '%s\n' "${skipped[@]:-}" | jq -R . | jq -sc 'map(select(length>0))')" \
         --arg backup "$stamp" --arg id "$id" --argjson reloaded "$reloaded" \
    '{ok:true, activeProfileId:$id, applied:$applied, skipped:$skipped, backup:$backup, reloaded:$reloaded}'
}

# ---------------------------------------------------------------- revert

cmd_revert() {
  ensure_state
  take_lock

  local ts
  ts="${1:-$(store_jq -r '.state.lastBackup // ""')}"
  [ -n "$ts" ] || refuse "E_NO_BACKUP" "There is no backup to go back to."
  # A backup name is a timestamp this script wrote. Anything else is not a
  # backup, and a path fragment is certainly not one.
  case "$ts" in
    */*|*..*) refuse "E_NO_BACKUP" "\"$ts\" is not a backup name." ;;
  esac
  case "$ts" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]-[0-9][0-9]-[0-9][0-9]Z) ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]-[0-9][0-9]-[0-9][0-9]Z-[1-9]) ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]-[0-9][0-9]-[0-9][0-9]Z-[1-9][0-9]) ;;
    *) refuse "E_NO_BACKUP" "\"$ts\" is not a backup name." ;;
  esac
  local dir="$BACKUPS/$ts"
  [ -s "$dir/meta.json" ] || refuse "E_NO_BACKUP" "Backup $ts is gone or empty."

  # A revert is a write like any other, so it gets its own backup first: undo
  # has to be undoable or it is just a second way to lose the config.
  local stamp new_dir
  stamp="$(new_backup_stamp)"; new_dir="$BACKUPS/$stamp"
  mkdir -p "$new_dir"

  local files logical path
  local meta_f
  meta_f="$(read_capped "$dir/meta.json" "$MAX_BACKUP_BYTES" "that backup's manifest")" \
    || refuse "E_NO_BACKUP" "Backup $ts cannot be read."
  files=$(jq -c '.files[]' "$meta_f" 2>/dev/null) || { rm -f "$meta_f"; refuse "E_NO_BACKUP" "Backup $ts is not readable any more."; }
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    logical=$(printf '%s' "$f" | jq -r '.logical')
    path="$(file_for "$logical")"
    if [ -f "$path" ]; then
      cp -pL "$path" "$new_dir/$logical.json" \
        || refuse "E_PERM" "Cannot back up $(basename "$path") before undoing."
    fi
  done <<< "$files"

  local to_id new_files='[]'
  to_id=$(store_jq -r '.state.activeProfileId // ""')
  # Describe the state this backup actually holds, not the one it is undoing.
  # Copying the old meta forward made a backup advertise someone else's digests.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    logical=$(printf '%s' "$f" | jq -r '.logical')
    [ -f "$new_dir/$logical.json" ] || continue
    new_files=$(jq -cn --argjson acc "$new_files" --arg l "$logical" --arg p "$(file_for "$logical")" \
      --arg fp "$(fingerprint_logical "$logical")" '$acc + [{logical:$l, path:$p, fingerprint:$fp}]')
  done <<< "$files"
  jq -n --arg ts "$stamp" --arg from "$to_id" --argjson files "$new_files" \
    '{ts:$ts, fromProfileId:(if $from=="" then null else $from end), toProfileId:null, files:$files}' \
    > "$new_dir/meta.json"

  # Gate every restore before performing any of them. Checking inside the write
  # loop meant a refusal on the second file left the first one already rolled
  # back, under an exit code that promises nothing was written.
  local restorable='[]'
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    logical=$(printf '%s' "$f" | jq -r '.logical')
    # The path the backup came FROM, not whatever resolves today.
    path=$(printf '%s' "$f" | jq -r '.path // empty')
    [ -n "$path" ] || path="$(file_for "$logical")"
    # Restores land only where this tool writes. $OMO_DIR is on the list because
    # oh-my-openagent's config lives there — without it an undo silently skipped
    # the whole oh-my-openagent half and still reported success.
    case "$path" in "$CFG_DIR"/*|"$OMO_DIR"/*|"$HOME_CFG") ;; *) continue ;; esac
    # A manifest naming a payload that is not there is a broken backup, not a
    # backup with less in it. Saying so beats reporting a successful undo that
    # restored nothing and still moved the active profile.
    [ -s "$dir/$logical.json" ] \
      || refuse "E_NO_BACKUP" "Backup $ts is missing the copy of $(basename "$path")."
    preflight_restore "$path" "$dir/$logical.json"
    restorable=$(jq -cn --argjson acc "$restorable" --arg l "$logical" --arg p "$path" \
      '$acc + [{logical:$l, path:$p}]')
  done <<< "$files"

  [ "$(printf '%s' "$restorable" | jq -r 'length')" != "0" ] \
    || refuse "E_NO_BACKUP" "Backup $ts has nothing in it that can be put back."

  local restored='[]' put_back=() rrc=0
  OC_ROLLBACK_DIR="$new_dir"; OC_ROLLBACK_WROTE=()
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    logical=$(printf '%s' "$entry" | jq -r '.logical')
    path=$(printf '%s' "$entry" | jq -r '.path')
    put_back+=("$logical"); OC_ROLLBACK_WROTE+=("$logical")
    # The backup is a byte copy this tool made, but it lives in a directory anything
    # running as this user can write, so it is read back under the same rules as
    # everything else rather than cat'd straight over a config.
    if ! "$SELF_DIR/safe-read" "$dir/$logical.json" --max-bytes "$MAX_BACKUP_BYTES" \
         --label "that backup" | atomic_write "$path"; then rrc=1; break; fi
    restored=$(jq -cn --argjson acc "$restored" --arg l "$logical" '$acc + [$l]')
  done <<< "$(printf '%s' "$restorable" | jq -c '.[]')"

  if [ "$rrc" -ne 0 ]; then
    local l
    for l in "${put_back[@]:-}"; do
      [ -n "$l" ] || continue
      [ -f "$new_dir/$l.json" ] || continue
      "$SELF_DIR/safe-read" "$new_dir/$l.json" --max-bytes "$MAX_BACKUP_BYTES" --label "that backup" \
        2>/dev/null | atomic_write "$(file_for "$l")" 2>/dev/null || true
    done
    OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The undo failed and the config was put back as it was.", backup:$backup}'
    exit 3
  fi
  OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()

  local back_to
  back_to=$(jq -r '.fromProfileId // ""' "$meta_f" 2>/dev/null)
  rm -f "$meta_f"
  # A backup taken before any profile was active records no `fromProfileId`, and
  # older backups predate the field entirely. The config just put back is still
  # either one of the saved profiles or it is not, and the store should say which:
  # left null, the panel reports a config that matches "Saved config" exactly as
  # matching no profile at all.
  [ -n "$back_to" ] || back_to="$(matching_profile_id)"
  store_update --arg id "$back_to" --arg prev "$to_id" --arg at "$(now_iso)" --arg backup "$stamp" '
      .state.activeProfileId = (if $id == "" then null else $id end)
    | .state.previousProfileId = (if $prev == "" then null else $prev end)
    | .state.appliedAt = $at
    | .state.lastBackup = $backup
  '

  prune_backups

  local reloaded=0
  if [ "$OC_AUTO_RELOAD" = 1 ]; then reload_opencode && reloaded=1; fi

  jq -cn --arg ts "$ts" --arg backup "$stamp" --argjson restored "$restored" \
         --arg id "$back_to" --argjson reloaded "$reloaded" \
    '{ok:true, reverted:$ts, backup:$backup, restored:$restored,
      activeProfileId:(if $id=="" then null else $id end), reloaded:$reloaded}'
}

prune_backups() {
  [ "$OC_BACKUPS_KEEP" -ge 0 ] 2>/dev/null || return 0

  # The backup the store points at is the one Undo restores, so it is never a candidate:
  # with keepBackups 0 the prune would delete the copy taken seconds earlier.
  local keep_ts
  keep_ts=$(store_jq -r '.state.lastBackup // ""' 2>/dev/null)

  local doomed
  doomed=$(ls -1d "$BACKUPS"/*/ 2>/dev/null | sort | head -n "-$OC_BACKUPS_KEEP" 2>/dev/null)
  [ -n "$doomed" ] || return 0

  local d name
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    case "$d" in "$BACKUPS"/*) ;; *) continue ;; esac
    name=$(basename "${d%/}")
    [ "$name" = "$keep_ts" ] && continue
    [ -L "${d%/}" ] && { rm -f "${d%/}"; continue; }
    [ -d "${d%/}" ] || continue
    rm -rf "$d"
  done <<< "$doomed"
}

# ---------------------------------------------------------------- reload

# SIGUSR2 is opencode's own "re-read your config" signal, so a switch keeps the session.
# Only the TUI installs a handler and SIGUSR2's default disposition is death — check each pid.
# The value goes into arithmetic, never into interpreter source: a runtime value
# spliced into a `python3 -c` string is the shape of an injection even when today's
# source for it is the kernel.
catches_sigusr2() {
  local pid="$1" mask
  mask=$(awk '/^SigCgt:/{print $2}' "/proc/$pid/status" 2>/dev/null)
  case "$mask" in ''|*[!0-9a-fA-F]*) return 1 ;; esac
  # SIGUSR2 is signal 12, so it is bit 11 of the caught-signal mask.
  (( (16#$mask >> 11) & 1 )) 2>/dev/null
}

# Field 22 of /proc/<pid>/stat: the tick the process started on. Together with the
# pid it identifies one process rather than one slot in the pid table.
pid_identity() {
  local pid="$1" line
  line=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
  # The comm field is parenthesised and may itself contain spaces, so everything is
  # counted from the closing bracket rather than from the start of the line.
  printf '%s' "${line##*) }" | awk '{print $20}'
}

# pid:starttime, so the caller can tell the process it looked at from whatever holds
# that pid by the time it acts.
reloadable_pids() {
  local pid ident
  for pid in $(pgrep -x opencode 2>/dev/null); do
    catches_sigusr2 "$pid" || continue
    ident="$(pid_identity "$pid")" || continue
    [ -n "$ident" ] && printf '%s:%s\n' "$pid" "$ident"
  done
}

# SIGUSR2 terminates a process that does not handle it, and a pid is reused. So the
# pid is pinned to the process that was checked — same start tick, still an opencode,
# still handling the signal — in the instruction before the one that sends it.
reload_opencode() {
  local pids entry pid want now
  pids=$(reloadable_pids)
  [ -n "$pids" ] || return 1
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    pid="${entry%%:*}"; want="${entry#*:}"
    now="$(pid_identity "$pid")" || continue
    [ "$now" = "$want" ] || continue
    [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "opencode" ] || continue
    catches_sigusr2 "$pid" || continue
    kill -USR2 "$pid" 2>/dev/null
  done <<< "$pids"
  return 0
}

cmd_reload() {
  local pids n total skipped
  pids=$(reloadable_pids)
  n=$(printf '%s' "$pids" | grep -c . 2>/dev/null || true)
  [ -n "$n" ] || n=0
  total=$(pgrep -cx opencode 2>/dev/null || true)
  [ -n "$total" ] || total=0
  skipped=$((total - n))

  if [ "$n" -gt 0 ]; then
    reload_opencode
    jq -cn --argjson n "$n" --argjson skipped "$skipped" \
      '{ok:true, reloaded:$n, skipped:$skipped}'
  elif [ "$total" -gt 0 ]; then
    jq -cn --argjson skipped "$skipped" \
      '{ok:true, reloaded:0, skipped:$skipped,
        message:"opencode is running but not listening for a config reload."}'
  else
    jq -cn '{ok:true, reloaded:0, skipped:0, message:"opencode is not running."}'
  fi
}

# ---------------------------------------------------------------- capture

# Turn what is on disk right now into a profile — how "Save current config" works.
cmd_capture() {
  local name="${1:-}" id="${2:-}"
  [ -n "$name" ] || die "usage: oc-profiles capture <name> [id]"
  ensure_state
  take_lock

  if [ -z "$id" ]; then
    id=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
    [ -n "$id" ] || id="profile"
    local base="$id" n=2
    while store_jq -e --arg i "$id" 'any(.profiles[]; .id == $i)' >/dev/null 2>&1; do
      id="$base-$n"; n=$((n+1))
    done
  fi

  local targets='[]' logical file doc
  for logical in ohmy opencode; do
    applicable "$logical" || continue
    file="$(file_for "$logical")"
    [ -f "$file" ] || continue
    local live; live="$(read_projected "$logical")"
    [ "$live" != "null" ] || continue
    doc=$(printf '%s' "$live" | jq -c --argjson m "$(keys_for "$logical")" \
      '. as $in | reduce $m[] as $k ({}; if ($in|has($k)) then .[$k]=$in[$k] else . end)')
    # `manages` is the whole key list, not just the keys that happen to be set.
    # A snapshot has to be able to restore a key being *absent*, or coming back to
    # it leaves behind whatever the profile you were on had added.
    targets=$(jq -cn --argjson acc "$targets" --arg l "$logical" --argjson p "$doc" \
      --argjson m "$(keys_for "$logical")" \
      --arg fp "$(fingerprint_logical "$logical")" \
      --arg shape "$([ "$logical" = ohmy ] && echo oh-my-openagent || echo opencode)" \
      '$acc + [{file:$l, shape:$shape, manages:$m, fingerprint:$fp, payload:$p}]')
  done

  # An opencode.json holding only providers and MCP servers is a perfectly normal
  # config and the most common one on the plain side. It captures as a profile that
  # pins nothing, which is a legitimate thing to come back to.
  [ "$targets" != "[]" ] || refuse "E_EMPTY" "No opencode config file to save."

  # Two or three letters keeps the bar a fixed width. Initials of every word, not the
  # first two letters: "Full Opus" is FO, "Full OX Alpha" is FOA; one word takes two.
  local short
  short=$(printf '%s' "$name" | awk '{
    n = split($0, w, /[ _-]+/)
    if (n >= 2) { out = ""; for (i = 1; i <= n && length(out) < 3; i++) out = out substr(w[i], 1, 1); print out }
    else print substr($0, 1, 2)
  }' | tr '[:lower:]' '[:upper:]')

  store_update --arg id "$id" --arg name "$name" --arg short "$short" --arg at "$(now_iso)" --argjson t "$targets" '
      .profiles = ( (.profiles | map(select(.id != $id)))
        + [{id:$id, name:$name, shortName:$short, description:"",
            createdAt:$at, updatedAt:$at, targets:$t}] )
  '

  jq -cn --arg id "$id" --arg name "$name" '{ok:true, id:$id, name:$name}'
}

# First run. A brand-new store means the panel would otherwise open on "Custom",
# an empty list and a warning that nothing matches — which reads like a fault
# when nothing is wrong. Capturing what is already there costs one read and
# gives the user their own setup to look at, and to come back to.
#
# Refuses once any profile exists, so it can never overwrite a real store. It
# writes no config file: the profile is taken FROM disk, so its fingerprints
# already match and marking it active is just bookkeeping.
cmd_seed() {
  ensure_state
  take_lock

  local existing
  existing=$(store_jq -r '.profiles | length' 2>/dev/null || echo 0)
  if [ "$existing" != "0" ]; then
    jq -cn '{ok:true, seeded:false, reason:"there are already profiles"}'
    return 0
  fi

  local ohmy opencode ok=0
  ohmy="$(resolve_ohmy)"; opencode="$(resolve_opencode)"
  for f in "$ohmy" "$opencode"; do
    [ -f "$f" ] && jq -e . "$f" >/dev/null 2>&1 && ok=1
  done
  if [ "$ok" != 1 ]; then
    jq -cn '{ok:true, seeded:false, reason:"no readable opencode config"}'
    return 0
  fi

  # cmd_capture takes the lock itself, so hand off rather than call it here.
  flock -u 9 2>/dev/null || true
  # In a subshell: refuse() is `exit 2`, so calling cmd_capture directly would end
  # the script here and print its refusal instead of seed's own answer. The capture
  # writes through the store, so a subshell loses nothing.
  ( cmd_capture "Current config" current-config ) >/dev/null 2>&1 || {
    jq -cn '{ok:true, seeded:false, reason:"nothing in the config to save"}'
    return 0
  }

  store_update --arg id current-config --arg at "$(now_iso)" '
      .state.activeProfileId = $id
    | .state.appliedAt = $at
  '
  jq -cn '{ok:true, seeded:true, id:"current-config"}'
}

# ---------------------------------------------------------------- store edits

# The panel hands a whole profile object in on stdin. Passing it as an argument
# would put a config through argv and into every process listing on the box.
cmd_save() {
  ensure_state
  take_lock
  local incoming
  # Quickshell's Process has no way to write to a child's stdin, so the panel hands the
  # profile over in the environment; a terminal still pipes. Neither route uses argv.
  if [ -n "${OC_PROFILE_JSON:-}" ]; then incoming="$OC_PROFILE_JSON"; else incoming=$(cat); fi
  printf '%s' "$incoming" | jq -e '.id and .name' >/dev/null 2>&1 \
    || refuse "E_BAD_PROFILE" "That profile has no id or no name."

  # Fingerprints are derived here, never trusted from the caller: a profile duplicated in
  # the panel carries the original's digest and would claim to match a config it does not.
  local rebuilt='[]' t logical payload mkeys
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    logical=$(printf '%s' "$t" | jq -r '.file')
    payload=$(printf '%s' "$t" | jq -c '.payload // {}')
    mkeys=$(printf '%s' "$t" | jq -c --argjson d "$(keys_for "$logical")" '.manages // $d')
    mkeys=$(clamp_manages "$mkeys" "$(keys_for "$logical")")
    t=$(printf '%s' "$t" | jq -c --argjson m "$mkeys" '.manages = $m')
    rebuilt=$(jq -cn --argjson acc "$rebuilt" --argjson t "$t" \
      --arg fp "$(payload_fingerprint "$payload" "$(keys_for "$logical")")" \
      '$acc + [ $t + {fingerprint: $fp} ]')
  done <<< "$(printf '%s' "$incoming" | jq -c '.targets[]?')"
  incoming=$(printf '%s' "$incoming" | jq -c --argjson t "$rebuilt" '.targets = $t')

  store_update --argjson p "$incoming" --arg at "$(now_iso)" '
      .profiles = ( (.profiles | map(select(.id != $p.id)))
        + [ $p + {updatedAt:$at, createdAt:( $p.createdAt // $at )} ] )
  '

  printf '%s' "$incoming" | jq -c '{ok:true, id:.id}'
}

cmd_delete() {
  local id="${1:-}"
  [ -n "$id" ] || die "usage: oc-profiles delete <profile-id>"
  ensure_state
  take_lock
  store_jq -e --arg id "$id" 'any(.profiles[]; .id == $id)' >/dev/null 2>&1 \
    || refuse "E_NO_PROFILE" "No profile called \"$id\"."
  store_update --arg id "$id" '
      .profiles = (.profiles | map(select(.id != $id)))
    | .state.activeProfileId = (if .state.activeProfileId == $id then null else .state.activeProfileId end)
    | .state.previousProfileId = (if .state.previousProfileId == $id then null else .state.previousProfileId end)
  '
  jq -cn --arg id "$id" '{ok:true, deleted:$id}'
}

# The store plus the live fingerprints, which together answer the only question
# the panel opens with: is what is running still what the active profile says?
cmd_list() {
  ensure_state
  local ohmy_fp opencode_fp
  ohmy_fp="$(fingerprint_logical ohmy)"
  opencode_fp="$(fingerprint_logical opencode)"

  # This is the one command whose output grows with the store, so it is the one that
  # reads it through the guard rather than by handing jq a path to reopen. Bounding
  # the input is not enough on its own: jq's pretty-printer turned a 150 KB store
  # into 174 MB here, so the output is capped as well, and compact.
  local raw
  raw="$(read_store)" \
    || refuse "E_STORE" "The profile store is not a plain file, or is too large to read."

  # `matches` makes a switch made outside this panel recognisable rather than reported as
  # damage. No jq `//` near a boolean: `false // true` is `true`, marking clean as drifted.
  #
  # `effectiveProfileId` is the one the panel should name. The stored id is only the
  # last profile switched *to*, and several ordinary paths leave it null while the
  # config on disk still matches a saved profile exactly — an undo to a backup taken
  # before any profile was active is the common one. Deriving drift from the stored id
  # alone reports such a config as matching nothing, which is the opposite of true.
  printf '%s' "$raw" | jq -c --arg ohmy "$ohmy_fp" --arg opencode "$opencode_fp" '
    . as $root
    | ($root.state.activeProfileId) as $id
    | def clean(p):
        (p.targets // [])
        | length > 0
        and ( map( .fingerprint == (if .file == "ohmy" then $ohmy else $opencode end) ) | all );
      [ $root.profiles[] | select(clean(.)) | .id ] as $matches
    | ( if ($id != null) and ( [ $root.profiles[] | select(.id == $id) ] | length ) > 0
        then $id
        else ( $matches[0] // null ) end ) as $eff
    | . + { live: { ohmy: $ohmy, opencode: $opencode },
            matches: $matches,
            effectiveProfileId: $eff }
    | .drift = ( if $eff == null then true
                 else ( [ $root.profiles[] | select(.id == $eff) ]
                        | if length == 0 then true else (clean(.[0]) | not) end )
                 end )
  ' | head -c "$MAX_EMIT_BYTES"
}

# Favourites and recents live beside the profiles: one file, one writer, nothing second
# to keep in step.
cmd_prefs() {
  ensure_state
  take_lock
  local incoming
  if [ -n "${OC_PREFS_JSON:-}" ]; then incoming="$OC_PREFS_JSON"; else incoming=$(cat); fi
  printf '%s' "$incoming" | jq -e 'type == "object"' >/dev/null 2>&1 \
    || refuse "E_BAD_PREFS" "Preferences must be an object."

  store_update --argjson p "$incoming" '
      # Deduped without unique_by, which sorts. The order here is "most recently
      # starred first", and sorting it alphabetically throws away the only thing
      # that makes the top of the list worth having.
      .favorites = (($p.favorites // .favorites // []) | map(select(type == "string"))
                    | reduce .[] as $x ([]; if index([$x]) == null then . + [$x] else . end))
    | .recents   = (($p.recents   // .recents   // []) | map(select(type == "string")) | .[0:8])
  '

  store_jq -c '{ok:true, favorites:(.favorites|length), recents:(.recents|length)}'
}

cmd_backups() {
  ensure_state
  local out='[]' d meta_f n=0
  # Newest first, and no further than the number kept: the list is for the panel's
  # undo, and an unbounded walk of a directory anything can add to is not one.
  for d in $(ls -1d "$BACKUPS"/*/ 2>/dev/null | sort -r); do
    [ "$n" -lt "$OC_BACKUPS_KEEP" ] || break
    meta_f="$(read_capped "$d/meta.json" "$MAX_BACKUP_BYTES" "a backup manifest")" || continue
    if jq -e . "$meta_f" >/dev/null 2>&1; then
      out=$(jq -cn --argjson acc "$out" --slurpfile m "$meta_f" '$acc + [$m[0]]')
      n=$((n + 1))
    fi
    rm -f "$meta_f"
  done
  printf '%s\n' "$out" | head -c "$MAX_EMIT_BYTES"
}

# ---------------------------------------------------------------- health

# What is wrong, as one JSON line the Health section parses:
#   {ok:true, issues:[{code,file,profile,agent,detail,fixable,fix}...]}
# Never locks, never writes a config. Everything but the final line goes to
# stderr, so stdout stays exactly one line. `fix` names the --fix code that
# repairs the issue, or "" when there is no automatic repair.
cmd_doctor() {
  ensure_state
  local ohmy opencode scope unified
  ohmy="$(resolve_ohmy)"
  opencode="$(resolve_opencode)"
  scope="$(scope_for ohmy)"
  unified=false
  [ "$scope" != '[]' ] && unified=true

  local ohmy_doc opencode_doc
  ohmy_doc="$(read_projected ohmy)"
  opencode_doc="$(read_projected opencode)"
  [ -n "$ohmy_doc" ] || ohmy_doc="null"
  [ -n "$opencode_doc" ] || opencode_doc="null"

  local issues='[]'

  # A bare model string under `agent` is a config opencode will not load —
  # the same shape the apply preflight refuses as E_AGENT_SHAPE.
  if [ "$opencode_doc" != "null" ]; then
    local k
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      issues="$(jq -cn --argjson acc "$issues" --arg f "$opencode" --arg k "$k" \
        '$acc + [{code:"E_BARE_AGENT_STRING", file:$f, profile:"", agent:$k,
                  detail:("agent." + $k + " is a bare model string; opencode needs { \"model\": ... } there."),
                  fixable:true, fix:"E_BARE_AGENT_STRING"}]')"
    done < <(printf '%s' "$opencode_doc" | jq -r \
      '(.agent // {}) | to_entries[] | select(.value | type != "object") | .key // empty' 2>/dev/null)
  fi

  # A file-level fallback_models under the unified [opencode] block is not a
  # field the schema has. Per-agent ones are fine — this is the file-level
  # key, which is a different thing that happens to share a name.
  if [ "$unified" = true ] && [ "$ohmy_doc" != "null" ]; then
    if printf '%s' "$ohmy_doc" | jq -e 'has("fallback_models")' >/dev/null 2>&1; then
      issues="$(jq -cn --argjson acc "$issues" --arg f "$ohmy" \
        '$acc + [{code:"E_FILE_FALLBACK", file:$f, profile:"", agent:"",
                  detail:"[opencode] has a file-level fallback_models key, which the unified config does not accept.",
                  fixable:true, fix:"E_FILE_FALLBACK"}]')"
    fi
  fi

  # An agent entry carrying `models` is the shape oh-my-openagent's own 4.19
  # migration writes and its own schema then strips: the agent loses its pin at
  # startup. A category is not an agent — CategoryConfigSchema does declare
  # `models` — so only the agent half is ever an issue, on disk or in the store.
  #
  # One row per profile rather than per agent. A migration rewrites every entry
  # it touches, so the per-agent list is two dozen rows saying one thing, and
  # the repair is one button either way.
  local raw
  raw="$(read_store 2>/dev/null)" || raw="$EMPTY_STORE"
  if printf '%s' "$raw" | jq -e . >/dev/null 2>&1; then
    local row pid pname pcount
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      pid="$(printf '%s' "$row" | jq -r '.profile')"
      pname="$(printf '%s' "$row" | jq -r '.name')"
      pcount="$(printf '%s' "$row" | jq -r '.count')"
      issues="$(jq -cn --argjson acc "$issues" --arg f "$PROFILES" \
        --arg p "$pid" --arg n "$pname" --argjson c "$pcount" \
        '$acc + [{code:"E_MODELS_IN_PROFILE", file:$f, profile:$p, agent:"", count:$c,
                  detail:("profile \"" + $n + "\": " + ($c|tostring)
                          + (if $c == 1 then " agent sets" else " agents set" end)
                          + " \"models\", which oh-my-openagent has no field for and strips at startup, leaving them with no model."),
                  fixable:true, fix:"E_MODELS_IN_PROFILE"}]')"
    done < <(printf '%s' "$raw" | jq -c '
      .profiles[]?
      | .id as $pid | (.name // .id) as $pname
      | [ .targets[]? | select(.file == "ohmy")
          | (.payload.agents // {}) | to_entries[]
          | select(.value | type == "object" and has("models")) ] as $hit
      | select(($hit | length) > 0)
      | {profile:$pid, name:$pname, count:($hit | length)}' 2>/dev/null)
  fi

  # The same shape on the live config, which is where `oh-my-openagent config
  # migrate` puts it: the file validates, the plugin starts, and every agent it
  # touched quietly runs on a default. Nothing else reports this, because
  # nothing else reads the schema that dropped the key.
  if [ "$ohmy_doc" != "null" ]; then
    local live_models
    live_models="$(printf '%s' "$ohmy_doc" | jq -r \
      '[(.agents // {}) | to_entries[] | select(.value | type == "object" and has("models"))] | length' 2>/dev/null)"
    case "$live_models" in ''|*[!0-9]*) live_models=0 ;; esac
    if [ "$live_models" -gt 0 ]; then
      issues="$(jq -cn --argjson acc "$issues" --arg f "$ohmy" --argjson c "$live_models" \
        '$acc + [{code:"E_MODELS_IN_CONFIG", file:$f, profile:"", agent:"", count:$c,
                  detail:(($c|tostring)
                          + (if $c == 1 then " agent in" else " agents in" end)
                          + " your oh-my-openagent config set \"models\", which its own schema drops on load — those agents are running on a default, not on the model you pinned."),
                  fixable:true, fix:"E_MODELS_IN_CONFIG"}]')"
    fi
  fi

  # A legacy per-harness file nobody reads any more, kept for information.
  # Never deleted automatically: it may be the only copy of an old setup.
  if [ -f "$OMO_DIR/omo.jsonc" ] || [ -f "$OMO_DIR/omo.json" ]; then
    local legacy
    for legacy in "$CFG_DIR/oh-my-openagent.jsonc" "$CFG_DIR/oh-my-openagent.json" \
                 "$CFG_DIR/oh-my-opencode.jsonc" "$CFG_DIR/oh-my-opencode.json"; do
      if [ -f "$legacy" ]; then
        issues="$(jq -cn --argjson acc "$issues" --arg f "$legacy" \
          '$acc + [{code:"W_LEGACY_OHMY", file:$f, profile:"", agent:"",
                    detail:"A legacy oh-my-openagent file exists while the unified ~/.omo config is active; it is no longer read.",
                    fixable:false, fix:""}]')"
      fi
    done
  fi

  # `variant` is the old spelling of `reasoning`. Both still load — the plugin
  # normalises one into the other at read time — so this is information only,
  # and one line rather than one line per entry: a config is migrated all at
  # once, so the count is the only part that differs between the rows.
  # No automatic repair renames a field that still works.
  if [ "$ohmy_doc" != "null" ]; then
    local vcount
    vcount="$(printf '%s' "$ohmy_doc" | jq -r '
      [ ((.agents // {}), (.categories // {})) | to_entries[]
        | select(.value | type == "object" and has("variant")) ] | length' 2>/dev/null)"
    case "$vcount" in ''|*[!0-9]*) vcount=0 ;; esac
    if [ "$vcount" -gt 0 ]; then
      issues="$(jq -cn --argjson acc "$issues" --arg f "$ohmy" --argjson c "$vcount" \
        '$acc + [{code:"W_VARIANT_DEPRECATED", file:$f, profile:"", agent:"", count:$c,
                  detail:(($c|tostring) + " entries use \"variant\"; the current spelling is \"reasoning\". Both are read, so nothing is broken."),
                  fixable:false, fix:""}]')"
    fi
  fi

  # Best effort only: whether the installed oh-my-openagent predates the 4.x
  # unified config. No network, no failure — when the version cannot be told,
  # there is simply no issue.
  {
    local pkg="" pf="" ver=""
    pkg="$(omo_package_dir)" || pkg=""
    if [ -n "$pkg" ]; then
      pf="$(read_capped "$pkg/package.json" "$MAX_PACKAGE_BYTES" "the oh-my-openagent package manifest")" || pf=""
      if [ -n "$pf" ]; then
        ver="$(jq -r '.version // ""' "$pf" 2>/dev/null)"; rm -f "$pf"
        case "$ver" in
          [0-3].*)
            issues="$(jq -cn --argjson acc "$issues" --arg v "$ver" \
              '$acc + [{code:"W_OUTDATED_OMO", file:"", profile:"", agent:"",
                        detail:("oh-my-openagent " + $v + " predates the unified config; consider upgrading."),
                        fixable:false, fix:""}]')" ;;
        esac
      fi
    fi
  } 2>/dev/null || true

  jq -cn --argjson issues "$issues" '{ok:true, issues:$issues}'
}

# ---------------------------------------------------------------- repair

# Fix one doctor code. A dry run by default: {ok:true, dryRun:true, diff:[...]}
# and nothing written, no lock taken. --apply backs up first, then writes,
# and reports {ok:true, fixed:N}. Anything else is a refusal (exit 2).
cmd_repair() {
  local fix="" profile="" apply=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix)       fix="${2:-}"; shift 2 ;;
      --fix=*)     fix="${1#--fix=}"; shift ;;
      --profile)   profile="${2:-}"; shift 2 ;;
      --profile=*) profile="${1#--profile=}"; shift ;;
      --apply)     apply=1; shift ;;
      *) refuse "E_BAD_FIX" "Unknown repair option \"$1\". Use --fix <code> [--profile <id>] [--apply]." ;;
    esac
  done
  [ -n "$fix" ] || refuse "E_BAD_FIX" "Nothing to repair. Use --fix <code> [--profile <id>] [--apply]."
  case "$fix" in
    E_MODELS_IN_PROFILE) repair_models "$profile" "$apply" ;;
    E_MODELS_IN_CONFIG)  repair_models_config "$apply" ;;
    E_BARE_AGENT_STRING) repair_bare "$apply" ;;
    E_FILE_FALLBACK)     repair_fallback "$apply" ;;
    W_LEGACY_OHMY|W_OUTDATED_OMO|W_VARIANT_DEPRECATED)
      refuse "E_NOT_FIXABLE" "\"$fix\" is information only and has no automatic repair." ;;
    *) refuse "E_BAD_FIX" "Unknown fix code \"$fix\"." ;;
  esac
}

# A repair that rewrote a config file is a write like any other, so Undo has to
# reach it: the footer restores `.state.lastBackup`, and a fix left out of that
# is a fix with no way back. Set before prune_backups, which reads the same field
# to decide which directory it may never delete.
#
# The store-only repair does not call this. Its backup holds no config, so
# pointing Undo at it would offer to restore nothing at all.
claim_backup() {
  local stamp="$1"
  store_update --arg backup "$stamp" '.state.lastBackup = $backup'
}

# One entry's `models` array, turned back into the pair the schema does have.
# `models[0]` is the pin, so it promotes into `model` when the entry has none of
# its own; the rest become `fallback_models`, with anything naming the pin again
# dropped (a string becomes {model:...}, an object carries over as-is). The
# ordering is oh-my-openagent's own: it read `model` + `fallback_models` in that
# order when it wrote the array, so reading it back the same way is lossless.
#
# A definition rather than a bare expression: the body is a pipeline, and a
# pipeline spliced straight into `.value |= …` binds to the wrong half of it —
# which rewrites nothing and leaves the caller preflighting the shape it was
# asked to remove. As a named function there is nothing left to get wrong.
MODELS_TO_FALLBACKS='def models_to_fallbacks:
  . as $e
  | ($e.models // null) as $m
  | if ($m | type) != "array" then ($e | del(.models))
    else
      (($e.model // null) as $cur
       | (if $cur != null then $cur
          else ($m[0] | if type == "string" then .
                         elif type == "object" then (.model // null)
                         else null end)
          end) as $base
       | ($m[1:] // []) as $rest
       | ([$rest[]
           | . as $el
           | if ($el | type) == "string" then
               (if $el != $base then {model:$el} else empty end)
             elif ($el | type) == "object" then
               (if (($el.model // null) != $base) then $el else empty end)
             else empty end]) as $fb
       | ($e | del(.models)
          | if $base != null then .model = $base else . end
          | if ($fb | length) > 0 then .fallback_models = $fb
            else del(.fallback_models) end))
    end;'

# The stored entry loses `models`, rebuilt by MODELS_TO_FALLBACKS above. Agents
# only: a category may carry `models` and rewriting one would be changing a
# config the software reads perfectly well. Only targets that actually changed
# get their manages clamped and their fingerprints re-derived.
repair_models() {
  local id="$1" apply="$2"
  [ -n "$id" ] || refuse "E_NO_PROFILE" "Repairing E_MODELS_IN_PROFILE needs --profile <id>."
  ensure_state
  [ "$apply" = 1 ] && take_lock

  local profile
  profile=$(store_jq -c --arg id "$id" '.profiles[] | select(.id == $id)' 2>/dev/null)
  [ -n "$profile" ] || refuse "E_NO_PROFILE" "No profile called \"$id\"."

  local rows
  rows=$(printf '%s' "$profile" | jq -c '
    .targets | to_entries[]
    | .key as $ti | .value
    | select(.file == "ohmy")
    | ((.payload.agents // {}) | to_entries[])
    | select(.value | type == "object" and has("models"))
    | {ti:$ti, kind:"agents", name:.key}' 2>/dev/null)

  local new_profile="$profile" diff='[]' fixed=0 tis='[]'
  local row ti kind name before after
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    ti="$(printf '%s' "$row" | jq -r '.ti')"
    kind="$(printf '%s' "$row" | jq -r '.kind')"
    name="$(printf '%s' "$row" | jq -r '.name')"
    before="$(printf '%s' "$new_profile" | jq -c \
      --argjson ti "$ti" --arg k "$kind" --arg n "$name" \
      '.targets[$ti].payload[$k][$n]')"
    after="$(printf '%s' "$before" | jq -c "$MODELS_TO_FALLBACKS models_to_fallbacks")"
    new_profile="$(printf '%s' "$new_profile" | jq -c \
      --argjson ti "$ti" --arg k "$kind" --arg n "$name" --argjson a "$after" \
      '.targets[$ti].payload[$k][$n] = $a')"
    diff="$(jq -cn --argjson d "$diff" --arg p "$id" \
      --arg k "$kind" --arg n "$name" --argjson b "$before" --argjson a "$after" \
      '$d + [{profile:$p, target:"ohmy", key:($k + "." + $n), before:$b, after:$a}]')"
    fixed=$((fixed + 1))
    tis="$(jq -cn --argjson t "$tis" --argjson i "$ti" \
      '$t + [$i] | unique')"
  done <<< "$rows"

  if [ "$apply" != 1 ]; then
    jq -cn --argjson d "$diff" '{ok:true, dryRun:true, diff:$d}'
    return 0
  fi

  [ "$fixed" -gt 0 ] || { jq -cn '{ok:true, fixed:0}'; return 0; }

  # Clamp and re-fingerprint the touched targets only: manages arrives from
  # the store, and under the unified scope "fallback_models" is not a key a
  # profile may own.
  local allowed payload mkeys fp
  allowed="$(keys_for ohmy)"
  while IFS= read -r ti; do
    [ -n "$ti" ] || continue
    mkeys="$(printf '%s' "$new_profile" | jq -c \
      --argjson ti "$ti" --argjson d "$allowed" '.targets[$ti].manages // $d')"
    mkeys="$(clamp_manages "$mkeys" "$allowed")"
    payload="$(printf '%s' "$new_profile" | jq -c \
      --argjson ti "$ti" '.targets[$ti].payload')"
    fp="$(payload_fingerprint "$payload" "$allowed")"
    new_profile="$(printf '%s' "$new_profile" | jq -c \
      --argjson ti "$ti" --argjson m "$mkeys" --arg fp "$fp" \
      '.targets[$ti].manages = $m | .targets[$ti].fingerprint = $fp')"
  done < <(printf '%s' "$tis" | jq -r '.[]?' 2>/dev/null)

  # The store is the thing being rewritten, so its own copy goes aside first.
  # files:[] keeps this backup out of revert's reach: there is no config in
  # it to put back.
  local stamp dir
  stamp="$(new_backup_stamp)"
  dir="$BACKUPS/$stamp"
  mkdir -p "$dir" || refuse "E_PERM" "Cannot create a backup directory."
  cp -pL "$PROFILES" "$dir/store.json" \
    || refuse "E_PERM" "Cannot back up the profile store."
  jq -n --arg ts "$stamp" \
    '{ts:$ts, fromProfileId:null, toProfileId:null, files:[], repair:"E_MODELS_IN_PROFILE"}' \
    > "$dir/meta.json"

  store_update --argjson p "$new_profile" --arg at "$(now_iso)" '
      .profiles = (.profiles | map(select(.id != $p.id)) + [$p + {updatedAt:$at}])'

  prune_backups
  warn "repair: profile store backup $stamp"
  jq -cn --argjson n "$fixed" '{ok:true, fixed:$n}'
}

# The same rewrite against the live oh-my-openagent config, which is where its
# own `config migrate` puts the shape its own schema then drops. Agents only,
# and spliced through jsonc-edit like every other write here, so the comments
# and the harness sections this tool does not manage come back untouched.
repair_models_config() {
  local apply="$1"
  ensure_state
  [ "$apply" = 1 ] && take_lock

  local file doc
  file="$(resolve_ohmy)"
  [ -f "$file" ] || refuse "E_MISSING" "$(basename "$file") does not exist."
  doc="$(read_projected ohmy)"
  [ -n "$doc" ] && [ "$doc" != "null" ] \
    || refuse "E_PARSE" "$(basename "$file") will not parse. Nothing was changed."

  local keys payload diff='[]' fixed=0
  keys=$(printf '%s' "$doc" | jq -r \
    '(.agents // {}) | to_entries[] | select(.value | type == "object" and has("models")) | .key // empty' 2>/dev/null)

  if [ -n "$keys" ]; then
    payload="$(printf '%s' "$doc" | jq -c "$MODELS_TO_FALLBACKS"'
      .agents |= with_entries(
        if (.value | type) == "object" and (.value | has("models"))
        then .value |= models_to_fallbacks else . end)' 2>/dev/null)"
    [ -n "$payload" ] || refuse "E_WRITE" "Could not rewrite the agent entries."
    local k before after
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      before="$(printf '%s' "$doc" | jq -c --arg k "$k" '.agents[$k]')"
      after="$(printf '%s' "$payload" | jq -c --arg k "$k" '.agents[$k]')"
      diff="$(jq -cn --argjson d "$diff" --arg f "$file" --arg k "$k" \
        --argjson b "$before" --argjson a "$after" \
        '$d + [{file:$f, target:"ohmy", key:("agents." + $k), before:$b, after:$a}]')"
      fixed=$((fixed + 1))
    done <<< "$keys"
  else
    payload="$doc"
  fi

  if [ "$apply" != 1 ]; then
    jq -cn --argjson d "$diff" '{ok:true, dryRun:true, diff:$d}'
    return 0
  fi
  [ "$fixed" -gt 0 ] || { jq -cn '{ok:true, fixed:0}'; return 0; }

  # Only `agents` is written back. A payload naming `categories` as well would
  # have this rewrite own a key it did not touch, and a managed key a profile
  # omits is a key an apply deletes.
  local mkeys='["agents"]'
  payload="$(printf '%s' "$payload" | jq -c '{agents}')"
  preflight ohmy "$payload" "$file"

  local stamp dir
  stamp="$(new_backup_stamp)"
  dir="$BACKUPS/$stamp"
  mkdir -p "$dir" || refuse "E_PERM" "Cannot create a backup directory."
  cp -pL "$file" "$dir/ohmy.json" \
    || refuse "E_PERM" "Cannot back up $(basename "$file")."
  jq -n --arg ts "$stamp" --arg p "$file" --arg fp "$(fingerprint_logical ohmy)" \
    '{ts:$ts, fromProfileId:null, toProfileId:null, files:[{logical:"ohmy", path:$p, fingerprint:$fp}]}' \
    > "$dir/meta.json"

  OC_ROLLBACK_DIR="$dir"; OC_ROLLBACK_WROTE=(ohmy)
  if ! write_projected ohmy "$payload" "$mkeys" | atomic_write "$file"; then
    "$SELF_DIR/safe-read" "$dir/ohmy.json" --max-bytes "$MAX_BACKUP_BYTES" \
      --label "that backup" 2>/dev/null | atomic_write "$file" 2>/dev/null || true
    OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The repair failed and the previous config was put back.", backup:$backup}'
    exit 3
  fi
  OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()

  # Read back rather than trust the write: a splice that landed but left a
  # `models` behind is the one outcome this repair exists to prevent.
  local check left
  check="$(read_projected ohmy)"
  left=""
  if [ "$check" = "null" ] || [ -z "$check" ]; then left="unreadable"; else
    left=$(printf '%s' "$check" | jq -r \
      '(.agents // {}) | to_entries[] | select(.value | type == "object" and has("models")) | .key // empty' 2>/dev/null \
      | head -1)
  fi
  if [ -n "$left" ]; then
    "$SELF_DIR/safe-read" "$dir/ohmy.json" --max-bytes "$MAX_BACKUP_BYTES" \
      --label "that backup" 2>/dev/null | atomic_write "$file" 2>/dev/null || true
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The repair did not land and the previous config was put back.", backup:$backup}'
    exit 3
  fi

  claim_backup "$stamp"
  prune_backups
  warn "repair: backup $stamp"
  jq -cn --argjson n "$fixed" '{ok:true, fixed:$n}'
}

# A bare agent.<name> string becomes {model:...} through the same projected
# write an apply uses: preflighted, backed up, spliced so comments survive.
repair_bare() {
  local apply="$1"
  ensure_state
  [ "$apply" = 1 ] && take_lock

  local file doc
  file="$(resolve_opencode)"
  [ -f "$file" ] || refuse "E_MISSING" "$(basename "$file") does not exist."
  doc="$(read_projected opencode)"
  [ -n "$doc" ] && [ "$doc" != "null" ] \
    || refuse "E_PARSE" "$(basename "$file") will not parse. Nothing was changed."

  local keys payload diff='[]' fixed=0
  keys=$(printf '%s' "$doc" | jq -r \
    '(.agent // {}) | to_entries[] | select(.value | type == "string") | .key // empty' 2>/dev/null)
  local weird
  weird=$(printf '%s' "$doc" | jq -r \
    '(.agent // {}) | to_entries[] | select(.value | type != "object" and type != "string") | .key // empty' 2>/dev/null \
    | head -1)
  if [ -n "$keys" ]; then
    payload="$(printf '%s' "$doc" | jq -c \
      '.agent |= with_entries(if (.value | type) == "string" then .value = {model:.value} else . end)')"
    local k before after
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      before="$(printf '%s' "$doc" | jq -c --arg k "$k" '.agent[$k]')"
      after="$(printf '%s' "$payload" | jq -c --arg k "$k" '.agent[$k]')"
      diff="$(jq -cn --argjson d "$diff" --arg f "$file" --arg k "$k" \
        --argjson b "$before" --argjson a "$after" \
        '$d + [{file:$f, target:"opencode", key:("agent." + $k), before:$b, after:$a}]')"
      fixed=$((fixed + 1))
    done <<< "$keys"
  else
    payload="$doc"
  fi

  if [ "$apply" != 1 ]; then
    jq -cn --argjson d "$diff" '{ok:true, dryRun:true, diff:$d}'
    return 0
  fi

  [ -z "$weird" ] || refuse "E_AGENT_SHAPE" \
    "\"$weird\" is not a model string or an object; fix it by hand."
  [ "$fixed" -gt 0 ] || { jq -cn '{ok:true, fixed:0}'; return 0; }

  local mkeys stamp dir
  mkeys="$(keys_for opencode)"
  preflight opencode "$payload" "$file"

  stamp="$(new_backup_stamp)"
  dir="$BACKUPS/$stamp"
  mkdir -p "$dir" || refuse "E_PERM" "Cannot create a backup directory."
  cp -pL "$file" "$dir/opencode.json" \
    || refuse "E_PERM" "Cannot back up $(basename "$file")."
  jq -n --arg ts "$stamp" --arg p "$file" --arg fp "$(fingerprint_logical opencode)" \
    '{ts:$ts, fromProfileId:null, toProfileId:null, files:[{logical:"opencode", path:$p, fingerprint:$fp}]}' \
    > "$dir/meta.json"

  OC_ROLLBACK_DIR="$dir"; OC_ROLLBACK_WROTE=(opencode)
  if ! write_projected opencode "$payload" "$mkeys" | atomic_write "$file"; then
    "$SELF_DIR/safe-read" "$dir/opencode.json" --max-bytes "$MAX_BACKUP_BYTES" \
      --label "that backup" 2>/dev/null | atomic_write "$file" 2>/dev/null || true
    OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The repair failed and the previous config was put back.", backup:$backup}'
    exit 3
  fi
  OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()

  local check left
  check="$(read_projected opencode)"
  left=""
  if [ "$check" = "null" ] || [ -z "$check" ]; then left="unreadable"; else
    left=$(printf '%s' "$check" | jq -r \
      '(.agent // {}) | to_entries[] | select(.value | type != "object") | .key // empty' 2>/dev/null \
      | head -1)
  fi
  if [ -n "$left" ]; then
    "$SELF_DIR/safe-read" "$dir/opencode.json" --max-bytes "$MAX_BACKUP_BYTES" \
      --label "that backup" 2>/dev/null | atomic_write "$file" 2>/dev/null || true
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The repair did not land and the previous config was put back.", backup:$backup}'
    exit 3
  fi

  claim_backup "$stamp"
  prune_backups
  warn "repair: backup $stamp"
  jq -cn --argjson n "$fixed" '{ok:true, fixed:$n}'
}

# The file-level fallback_models under [opencode] is deleted with a splice —
# one key's span, never a re-serialisation — so the file's comments survive.
repair_fallback() {
  local apply="$1"
  ensure_state
  [ "$apply" = 1 ] && take_lock

  local file scope doc
  file="$(resolve_ohmy)"
  scope="$(scope_for ohmy)"
  [ "$scope" != '[]' ] \
    || refuse "E_NOT_FIXABLE" "File-level fallback_models is only wrong under the unified [opencode] config."
  [ -f "$file" ] || refuse "E_MISSING" "$(basename "$file") does not exist."
  doc="$(read_projected ohmy)"
  [ -n "$doc" ] && [ "$doc" != "null" ] \
    || refuse "E_PARSE" "$(basename "$file") will not parse. Nothing was changed."

  local before
  before="$(printf '%s' "$doc" | jq -c '.fallback_models // empty' 2>/dev/null)"
  local diff='[]'
  if [ -n "$before" ]; then
    diff="$(jq -cn --arg f "$file" --argjson b "$before" \
      '[{file:$f, target:"ohmy", key:"fallback_models", before:$b, after:null}]')"
  fi

  if [ "$apply" != 1 ]; then
    jq -cn --argjson d "$diff" '{ok:true, dryRun:true, diff:$d}'
    return 0
  fi

  if [ -z "$before" ]; then jq -cn '{ok:true, fixed:0}'; return 0; fi

  preflight ohmy '{}' "$file"

  local stamp dir k
  stamp="$(new_backup_stamp)"
  dir="$BACKUPS/$stamp"
  mkdir -p "$dir" || refuse "E_PERM" "Cannot create a backup directory."
  cp -pL "$file" "$dir/ohmy.json" \
    || refuse "E_PERM" "Cannot back up $(basename "$file")."
  jq -n --arg ts "$stamp" --arg p "$file" --arg fp "$(fingerprint_logical ohmy)" \
    '{ts:$ts, fromProfileId:null, toProfileId:null, files:[{logical:"ohmy", path:$p, fingerprint:$fp}]}' \
    > "$dir/meta.json"

  OC_ROLLBACK_DIR="$dir"; OC_ROLLBACK_WROTE=(ohmy)
  local args=(apply "$file" --payload '{}' --manages '["fallback_models"]')
  while IFS= read -r k; do [ -n "$k" ] && args+=(--scope "$k"); done < <(printf '%s' "$scope" | jq -r '.[]?')
  if ! "$JSONC" "${args[@]}" | atomic_write "$file"; then
    "$SELF_DIR/safe-read" "$dir/ohmy.json" --max-bytes "$MAX_BACKUP_BYTES" \
      --label "that backup" 2>/dev/null | atomic_write "$file" 2>/dev/null || true
    OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The repair failed and the previous config was put back.", backup:$backup}'
    exit 3
  fi
  OC_ROLLBACK_DIR=""; OC_ROLLBACK_WROTE=()

  local check
  check="$(read_projected ohmy)"
  if [ -z "$check" ] || [ "$check" = "null" ] \
     || printf '%s' "$check" | jq -e 'has("fallback_models")' >/dev/null 2>&1; then
    "$SELF_DIR/safe-read" "$dir/ohmy.json" --max-bytes "$MAX_BACKUP_BYTES" \
      --label "that backup" 2>/dev/null | atomic_write "$file" 2>/dev/null || true
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The repair did not land and the previous config was put back.", backup:$backup}'
    exit 3
  fi

  claim_backup "$stamp"
  prune_backups
  warn "repair: backup $stamp"
  jq -cn '{ok:true, fixed:1}'
}

usage() {
  cat <<'USAGE'
oc-profiles — read and switch opencode model profiles

  detect                    what is on disk, what is running, what is authed
  list                      the profile store plus live fingerprints and drift
  capture <name> [id]       save the live config as a new profile
  seed                      on an empty store, save the live config as the first profile
  apply <id>                switch to a profile (backs up, writes, reloads)
  revert [<backup-ts>]      put the previous config back
  save                      upsert a profile object from stdin or $OC_PROFILE_JSON
  delete <id>               remove a profile
  prefs                     upsert {favorites,recents} from stdin or $OC_PREFS_JSON
  backups                   every backup taken, newest first
  reload                    tell a running opencode to re-read its config
  doctor                    report config health as one JSON line (never writes)
  repair --fix CODE [--profile ID] [--apply]
                            dry-run a repair by default; --apply writes it (backs up first)

Settings come from the environment:
  OC_MANAGE_OHMY=1  OC_MANAGE_OPENCODE=1  OC_AUTO_RELOAD=1  OC_BACKUPS_KEEP=10
USAGE
}

# ---------------------------------------------------------------- entry

need jq
need date
need flock
need python3
need sha256sum

# The helpers are how this reads and writes anything at all. Missing, every command
# would refuse with a story about the profile store instead of the truth.
for helper in safe-read safe-write jsonc-edit; do
  [ -x "$SELF_DIR/$helper" ] || die "oc-profiles: $SELF_DIR/$helper is missing or not executable"
done

case "${1:-}" in
  detect)   shift; cmd_detect "$@" ;;
  list)     shift; cmd_list "$@" ;;
  capture)  shift; cmd_capture "$@" ;;
  seed)     shift; cmd_seed "$@" ;;
  apply)    shift; cmd_apply "$@" ;;
  revert)   shift; cmd_revert "$@" ;;
  save)     shift; cmd_save "$@" ;;
  delete)   shift; cmd_delete "$@" ;;
  prefs)    shift; cmd_prefs "$@" ;;
  backups)  shift; cmd_backups "$@" ;;
  reload)   shift; cmd_reload "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  repair)   shift; cmd_repair "$@" ;;
  --version) printf '%s\n' "$VERSION" ;;
  -h|--help|"") usage ;;
  *) usage; exit 1 ;;
esac
