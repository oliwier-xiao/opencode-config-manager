#!/usr/bin/env bash
# oc-profiles — the only thing that writes an opencode config file; the panel only
# reads. jq only ever assigns the keys named in `manages`, so providers, MCP servers,
# plugin lists and API keys come out the other side byte-equal.
# Exit codes: 0 ok. 1 usage. 2 refused, nothing written. 3 partial write, all restored.

set -uo pipefail

# Opening a FIFO blocks inside open(2), before any check can run, and nothing here
# legitimately takes half a minute, so the run is bounded from the outside rather
# than guessed at from the inside. The panel already treats any other exit as a crash.
if [ "${OC_TIMEBOXED:-0}" != 1 ] && command -v timeout >/dev/null 2>&1; then
  export OC_TIMEBOXED=1
  exec timeout -k 2 30 "$0" "$@"
fi

VERSION="1.1.0"
PLUGIN_ID="oliwier.opencode-configs"

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
CACHE="$CACHE_HOME/omarchy/$PLUGIN_ID"

CFG_DIR="${OPENCODE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"
DEFAULT_CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"

# oh-my-openagent 4.x keeps its user config outside the opencode config dir, in
# ~/.omo, and shares one file across harnesses. OMO_CONFIG_HOME is here so a test
# can point the whole omo half somewhere disposable.
OMO_DIR="${OMO_CONFIG_HOME:-$HOME/.omo}"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JSONC="$SELF_DIR/jsonc-edit"

# A profile only makes sense for the config it was captured from, so a non-default
# CFG_DIR gets its own store; the default folder keeps the plain path it always had.
STATE="$STATE_HOME/omarchy/opencode-configs"
if [ "$CFG_DIR" != "$DEFAULT_CFG_DIR" ]; then
  STATE="$STATE/by-config/$(printf '%s' "$CFG_DIR" | sha256sum | cut -c1-12)"
fi

PROFILES="$STATE/profiles.json"
BACKUPS="$STATE/backups"
HOME_CFG="$HOME/.opencode/opencode.json"
AUTH_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json"

# Settings arrive as environment so the panel and a terminal drive the same code.
OC_MANAGE_OHMY="${OC_MANAGE_OHMY:-1}"
OC_MANAGE_OPENCODE="${OC_MANAGE_OPENCODE:-1}"
OC_AUTO_RELOAD="${OC_AUTO_RELOAD:-1}"
OC_BACKUPS_KEEP="${OC_BACKUPS_KEEP:-10}"

# The keys each shape lets a profile own. Nothing outside these lists is ever
# assigned, deleted, or reordered.
OHMY_KEYS='["agents","categories","fallback_models"]'
OPENCODE_KEYS='["model","small_model","agent"]'

# oh-my-openagent 4.x declares additionalProperties:false on an agent entry: an unknown
# key makes it drop the whole entry silently, unconfiguring the agent with no error.
OHMY_FORBIDDEN_FIELDS='["reasoning","models","displayName","provider"]'

# ---------------------------------------------------------------- plumbing

die()  { printf '%s\n' "$*" >&2; exit 1; }
warn() { printf '%s\n' "$*" >&2; }

# Every failure the panel can act on comes back as JSON on stdout, so the
# difference between "refused" and "crashed" is never a guess.
refuse() {
  local code="$1"; shift
  jq -cn --arg code "$code" --arg message "$*" \
    '{ok:false, code:$code, message:$message}'
  exit 2
}

need() { command -v "$1" >/dev/null 2>&1 || die "oc-profiles: $1 is required"; }

now_iso()  { date -u +%Y-%m-%dT%H:%M:%SZ; }
now_stamp(){ date -u +%Y-%m-%dT%H-%M-%SZ; }

# The stamp has one-second resolution and an undo lands well inside one second: without
# a unique name the revert's own backup overwrites the copy it is about to restore from.
new_backup_stamp() {
  local base suffix candidate
  base="$(now_stamp)"
  candidate="$base"
  suffix=2
  while [ -e "$BACKUPS/$candidate" ] && [ "$suffix" -lt 100 ]; do
    candidate="$base-$suffix"
    suffix=$((suffix + 1))
  done
  printf '%s' "$candidate"
}

# A projection of only the managed keys, key-sorted so the digest does not move
# when a file is reformatted or its keys reordered by hand.
fingerprint() {
  local file="$1" keys="$2"
  [ -r "$file" ] || { printf 'sha256:absent'; return 0; }
  local fp
  fp=$(jq -S -c --argjson m "$keys" \
        '. as $in | reduce $m[] as $k ({}; if ($in|has($k)) then .[$k]=$in[$k] else . end)' \
        "$file" 2>/dev/null | sha256sum 2>/dev/null | cut -c1-16)
  [ -n "$fp" ] || fp="unreadable"
  printf 'sha256:%s' "$fp"
}

# fingerprint() over whatever a logical target actually contributes, which for the
# unified omo config is one key deep rather than the whole file.
fingerprint_logical() {
  local logical="$1" doc
  doc="$(read_projected "$logical")"
  [ -n "$doc" ] && [ "$doc" != "null" ] || { printf 'sha256:absent'; return 0; }
  payload_fingerprint "$doc" "$(keys_for "$logical")"
}

# fingerprint() over a profile's stored payload instead of a file. It must project
# through `manages` the same way, or a profile never matches the file it came from.
payload_fingerprint() {
  local payload="$1" keys="$2"
  local fp
  fp=$(printf '%s' "$payload" | jq -S -c --argjson m "$keys" \
        '. as $in | reduce $m[] as $k ({}; if ($in|has($k)) then .[$k]=$in[$k] else . end)' \
        2>/dev/null | sha256sum 2>/dev/null | cut -c1-16)
  [ -n "$fp" ] || fp="unreadable"
  printf 'sha256:%s' "$fp"
}

# Temp file in the same directory, then rename(2): a reader sees the whole old file or
# the whole new one, never a truncated config opencode may be reading as we write it.
atomic_write() {
  local dest="$1" tmp
  # Follow the link and write what it points at; renaming over the link itself
  # detaches a dotfiles-managed config from whatever manages it.
  dest="$(readlink -f "$dest" 2>/dev/null || printf '%s' "$dest")"
  # mktemp, not a name built from $PID: a predictable temp path is a symlink
  # someone else can plant to redirect this write somewhere it should not go.
  # mktemp creates it O_EXCL, so the redirect cannot win the race either.
  tmp="$(mktemp "$(dirname "$dest")/.$(basename "$dest").XXXXXXXX" 2>/dev/null)" || return 1
  cat > "$tmp" || { rm -f "$tmp"; return 1; }
  [ -s "$tmp" ] || { rm -f "$tmp"; return 1; }
  if [ -e "$dest" ]; then chmod --reference="$dest" "$tmp" 2>/dev/null || true; fi
  mv -f "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
}

# The store sits in a directory anything running as this user can write, and `list`
# hands it to a panel living inside omarchy-shell — one process for the whole
# desktop. So it is judged on the descriptor that will be read rather than on its
# name: a name checked and then opened is a name that can be replaced in between.
MAX_STORE_BYTES=2097152

# Whatever this prints ends up buffered whole inside omarchy-shell before the panel
# gets a chance to measure it, so the two commands whose output grows with a file
# somebody else wrote are capped here, at the end they come out of.
MAX_EMIT_BYTES=4194304

# safe_open <path> <max-bytes> — leaves the file open on fd 3, or returns non-zero:
# 1 it is not there, 2 it is not a plain file, is too large, or the name moved.
safe_open() {
  local path="$1" cap="$2" meta size dev ino type
  { exec 3< "$path"; } 2>/dev/null || return 1
  # /dev/fd/3 is the descriptor, not the name it was opened under, so this is what
  # will actually be read. Split on a delimiter rather than on spaces: `%F` is
  # "regular file", two words, and would shift every field along.
  meta="$(stat -L -c '%s|%d|%i|%F' /dev/fd/3 2>/dev/null)" || { exec 3<&-; return 2; }
  IFS='|' read -r size dev ino type <<<"$meta"
  case "$type" in "regular file"|"regular empty file") ;; *) exec 3<&-; return 2 ;; esac
  case "$size" in ''|*[!0-9]*) exec 3<&-; return 2 ;; esac
  [ "$size" -le "$cap" ] || { exec 3<&-; return 2; }
  # lstat, no -L: a symlink's own inode is never its target's, so a mismatch means the
  # name led somewhere else, or leads somewhere else now. Own code, because this plugin's
  # own writers rename over the store and that looks identical from here.
  [ "$dev:$ino" = "$(stat -c '%d:%i' "$path" 2>/dev/null)" ] || { exec 3<&-; return 3; }
  return 0
}

# One retry, which is what tells a rename by atomic_write apart from a swap: a writer
# renames once and is then done, and nothing an attacker plants survives being refused.
open_store() {
  local rc=0
  safe_open "$PROFILES" "$MAX_STORE_BYTES" || rc=$?
  if [ "$rc" = 3 ]; then
    rc=0
    safe_open "$PROFILES" "$MAX_STORE_BYTES" || rc=$?
  fi
  return "$rc"
}

# The store as it will be parsed, capped where it is read rather than after. Callers
# do the refusing: refuse() here would only exit the substitution it is called from.
read_store() {
  open_store || return $?
  head -c "$MAX_STORE_BYTES" <&3
  local rc=$?
  exec 3<&-
  return $rc
}

EMPTY_STORE='{"version":1,"state":{"activeProfileId":null,"appliedAt":null,"lastBackup":null,"previousProfileId":null},"favorites":[],"recents":[],"profiles":[]}'

# `>` would follow a symlink and create, or truncate, whatever it points at — and a
# dangling one looks exactly like "no store yet". link(2) does not follow the name it
# is creating, so anything already sitting there is an error rather than a target.
create_store() {
  local tmp
  tmp="$(mktemp "$STATE/.profiles.json.XXXXXXXX" 2>/dev/null)" || return 1
  printf '%s\n' "$EMPTY_STORE" > "$tmp" || { rm -f "$tmp"; return 1; }
  ln "$tmp" "$PROFILES" 2>/dev/null || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
}

ensure_state() {
  mkdir -p "$STATE" "$BACKUPS" "$CACHE" 2>/dev/null || true
  local rc=0
  open_store || rc=$?
  case "$rc" in
    0) exec 3<&-
       # A zero-length store is an interrupted write, not a store. atomic_write
       # renames into place, so this never writes through the name either.
       [ -s "$PROFILES" ] || printf '%s\n' "$EMPTY_STORE" | atomic_write "$PROFILES" \
         || refuse "E_STORE" "Could not initialise the profile store." ;;
    1) create_store \
         || refuse "E_STORE" "Could not create the profile store. Something else is at $PROFILES." ;;
    *) refuse "E_STORE" "The profile store is not a plain file, or is too large to read." ;;
  esac
}

# One writer at a time: two switches racing is a user pressing twice, so the second is
# refused rather than queued. The lock is the state directory itself, opened read-only:
# flock works on any descriptor, and a directory cannot be swapped for a symlink to
# somebody's file the way a .lock beside the store can — that open truncates.
take_lock() {
  exec 9<"$STATE" 2>/dev/null || return 0
  flock -n 9 || refuse "E_BUSY" "Another switch is already running."
}

# ---------------------------------------------------------------- resolution

# The first path that exists wins, matching the loader's own order.
#
# oh-my-openagent 4.x resolves its user config to ~/.omo/omo.jsonc. The four names
# under the opencode config dir are what its one-shot "2026-07-opencode-config-
# unification" migration reads *from*: once that migration has run, writing to them
# changes nothing anyone reads. They stay in the list so a machine that has not
# upgraded yet is still editable, but they come second.
resolve_ohmy() {
  local p
  for p in "$OMO_DIR/omo.jsonc" "$OMO_DIR/omo.json"; do
    [ -f "$p" ] && { printf '%s' "$p"; return; }
  done
  for p in "$CFG_DIR/oh-my-openagent.jsonc" "$CFG_DIR/oh-my-openagent.json" \
           "$CFG_DIR/oh-my-opencode.jsonc"  "$CFG_DIR/oh-my-opencode.json"; do
    [ -f "$p" ] && { printf '%s' "$p"; return; }
  done
  printf '%s' "$OMO_DIR/omo.jsonc"
}

# The unified config carries one harness per key, so the opencode half of it sits
# under "[opencode]" rather than at the top level. The legacy per-harness files
# have no wrapper. Everything downstream reads and writes through this projection,
# which is why the rest of the script never has to know which shape it got.
scope_for() {
  case "$1" in
    ohmy)
      case "$(resolve_ohmy)" in
        "$OMO_DIR"/*) printf '%s' '["[opencode]"]' ;;
        *)            printf '%s' '[]' ;;
      esac
      ;;
    *) printf '%s' '[]' ;;
  esac
}

# Where opencode unpacks a plugin. Not $CACHE_HOME/opencode/node_modules — that
# path has never existed on any install; every plugin gets its own directory named
# after the spec it was requested by.
omo_package_dir() {
  local d
  for d in "$CACHE_HOME"/opencode/packages/oh-my-openagent@*/node_modules/oh-my-openagent \
           "$CACHE_HOME"/opencode/packages/oh-my-opencode@*/node_modules/oh-my-opencode; do
    [ -f "$d/package.json" ] && { printf '%s' "$d"; return 0; }
  done
  return 0
}

# The rosters come off the installed software, never out of this file. opencode
# names its agents in its own generated schema; oh-my-openagent ships a JSON Schema
# naming its agents and carries the category names as an enum in its bundle. A
# panel that guessed instead eventually offers somebody an agent that never existed
# — and then writes it into their config.
#
# Both probes are slow enough to be worth caching, and the cache key is the two
# versions, so an upgrade re-reads rather than serving yesterday's roster.
roster_json() {
  local pkg="$1" oc_version="$2" omo_version="$3"
  local key cache_file oc_agents om_agents om_cats
  key="$(printf '%s|%s' "$oc_version" "$omo_version" | sha256sum | cut -c1-16)"
  cache_file="$CACHE/roster-$key.json"
  if [ -s "$cache_file" ]; then cat "$cache_file"; return 0; fi

  oc_agents="$(command -v opencode >/dev/null 2>&1 \
    && opencode generate 2>/dev/null \
       | jq -c '[.components.schemas.Config.properties.agent.properties | keys[]]' 2>/dev/null)"
  case "$oc_agents" in ''|null) oc_agents='[]' ;; esac

  om_agents='[]'; om_cats='[]'
  if [ -n "$pkg" ]; then
    om_agents="$(jq -c '[.properties.agents.properties | keys[]]' \
      "$pkg/dist/oh-my-opencode.schema.json" 2>/dev/null)"
    case "$om_agents" in ''|null) om_agents='[]' ;; esac
    om_cats="$(python3 - "$pkg/dist/index.js" <<'PYEOF'
import json, re, sys
try:
    with open(sys.argv[1], encoding="utf-8", errors="replace") as fh:
        blob = fh.read()
except OSError:
    print("[]"); raise SystemExit
# The bundle is minified onto few lines, so this has to match across newlines.
m = re.search(r"BuiltinCategoryNameSchema\s*=\s*[A-Za-z_$][\w$]*\.enum\(\s*\[(.*?)\]\s*\)", blob, re.S)
print(json.dumps(re.findall(r'"([^"]+)"', m.group(1)) if m else []))
PYEOF
)"
    case "$om_cats" in ''|null) om_cats='[]' ;; esac
  fi

  local out
  out="$(jq -cn --argjson oca "$oc_agents" --argjson oma "$om_agents" --argjson omc "$om_cats" \
    '{opencode:{agents:$oca}, ohmy:{agents:$oma, categories:$omc}}')"
  mkdir -p "$CACHE" 2>/dev/null && printf '%s\n' "$out" > "$cache_file" 2>/dev/null || true
  printf '%s' "$out"
}

# `jsonc-edit read`, with the scope keys spread onto the command line.
read_projected() {
  local logical="$1" file scope k
  file="$(file_for "$logical")"
  [ -f "$file" ] || { printf 'null'; return 0; }
  scope="$(scope_for "$logical")"
  local args=(read "$file")
  while IFS= read -r k; do [ -n "$k" ] && args+=(--scope "$k"); done < <(printf '%s' "$scope" | jq -r '.[]?')
  "$JSONC" "${args[@]}" 2>/dev/null || printf 'null'
}

# The write half of the same projection: prints the whole new file on stdout, with
# every comment and every key this tool does not manage left exactly as it was.
write_projected() {
  local logical="$1" payload="$2" mkeys="$3" file scope k
  file="$(file_for "$logical")"
  scope="$(scope_for "$logical")"
  local args=(apply "$file" --payload "$payload" --manages "$mkeys")
  while IFS= read -r k; do [ -n "$k" ] && args+=(--scope "$k"); done < <(printf '%s' "$scope" | jq -r '.[]?')
  "$JSONC" "${args[@]}"
}

resolve_opencode() {
  local p
  for p in "$CFG_DIR/opencode.jsonc" "$CFG_DIR/opencode.json" "$CFG_DIR/config.json"; do
    [ -f "$p" ] && { printf '%s' "$p"; return; }
  done
  printf '%s' "$CFG_DIR/opencode.json"
}

file_for() {
  case "$1" in
    ohmy)     resolve_ohmy ;;
    opencode) resolve_opencode ;;
    *)        die "oc-profiles: unknown target '$1'" ;;
  esac
}

keys_for() {
  case "$1" in
    ohmy)     printf '%s' "$OHMY_KEYS" ;;
    opencode) printf '%s' "$OPENCODE_KEYS" ;;
  esac
}

managed() {
  case "$1" in
    ohmy)     [ "$OC_MANAGE_OHMY" = 1 ] ;;
    opencode) [ "$OC_MANAGE_OPENCODE" = 1 ] ;;
  esac
}

# Managed *and* actually present. A profile carrying an oh-my-openagent half is
# still worth applying on a machine that only runs opencode — the half that has a
# file lands, the other is reported as skipped. Refusing the whole switch over a
# file the user does not have is how a profile becomes permanently un-appliable.
applicable() {
  local logical="$1"
  managed "$logical" || return 1
  if [ "$logical" = "ohmy" ] && [ ! -f "$(file_for "$logical")" ]; then return 1; fi
  return 0
}

# jq reads these itself, from a path: passing a config as an --argjson value would put
# every provider API key and the MCP bearer token on a command line readable in /proc.
readable_json() {
  if [ -r "$1" ] && jq -e . "$1" >/dev/null 2>&1; then printf '%s' "$1"; else printf '%s' /dev/null; fi
}

# ---------------------------------------------------------------- detect

# Everything the panel needs to draw itself before the user touches anything. Only key
# *names* are ever read out of auth.json — this file prints no secret.
cmd_detect() {
  ensure_state
  local ohmy opencode
  ohmy="$(resolve_ohmy)"
  opencode="$(resolve_opencode)"

  local oc_version omo_version omo_pkg
  oc_version="$(command -v opencode >/dev/null 2>&1 && opencode --version 2>/dev/null | tr -d '\r' || true)"
  omo_pkg="$(omo_package_dir)"
  omo_version="$([ -n "$omo_pkg" ] && jq -r '.version // ""' "$omo_pkg/package.json" 2>/dev/null || true)"

  local authed
  authed="$(jq -c '[keys[]]' "$AUTH_FILE" 2>/dev/null || printf '[]')"

  # Built without a pipeline: under `set -o pipefail` a pgrep that matches nothing fails
  # the whole pipe, the `||` fallback fires on top of jq's own `[]`, and detect emits `[][]`.
  local pids pid_list=""
  for pid in $(pgrep -x opencode 2>/dev/null); do
    pid_list="${pid_list:+$pid_list,}$pid"
  done
  pids="[$pid_list]"

  # A project-level config shadows the user one, and editing the user file then has
  # no visible effect. Worth a warning rather than a silent no-op. oh-my-openagent
  # walks cwd upwards looking for .omo, nearest wins; opencode does the same with
  # .opencode. Both are worth reporting, and neither used to be found.
  local shadows='[]' probe="$PWD"
  while :; do
    # $HOME is where the user layer lives, so a hit there is the config itself
    # rather than something shadowing it. Only the directories below it count.
    if [ "$probe" != "$HOME" ]; then
      if [ -f "$probe/.omo/omo.jsonc" ] || [ -f "$probe/.omo/omo.json" ]; then
        shadows="$(printf '%s' "$shadows" | jq -c --arg d "$probe/.omo" '. + [$d]')"
      fi
      if [ -f "$probe/.opencode/opencode.json" ] || [ -f "$probe/.opencode/opencode.jsonc" ]; then
        shadows="$(printf '%s' "$shadows" | jq -c --arg d "$probe/.opencode" '. + [$d]')"
      fi
    fi
    case "$probe" in "$HOME"|/|"") break ;; esac
    probe="$(dirname "$probe")"
  done

  # Is oh-my-openagent actually in play? Three independent signals, because each
  # one alone is wrong for somebody: the package can be installed and unused, the
  # plugin can be declared before its config exists, and a config file can be left
  # behind by an uninstall. A leftover file on its own is reported, not obeyed.
  local opencode_doc omo_declared=false omo_installed=false omo_configured=false
  opencode_doc="$(read_projected opencode)"
  if printf '%s' "$opencode_doc" | jq -e '
        [ (.plugin // [])[] | if type == "array" then .[0] else . end ]
        | map(select(type == "string"))
        | any(test("(^|/)oh-my-open(agent|code)($|@)"))' >/dev/null 2>&1; then
    omo_declared=true
  fi
  [ -n "$omo_pkg" ] && omo_installed=true
  [ -f "$ohmy" ] && omo_configured=true

  local omo_active=false
  if [ "$omo_declared" = true ] || [ "$omo_installed" = true ]; then omo_active=true; fi

  local roster; roster="$(roster_json "$omo_pkg" "$oc_version" "$omo_version")"

  # The projections go to files rather than onto the command line: a config can
  # hold provider keys and an MCP bearer token, and /proc makes an argv public.
  local ohmy_doc_f opencode_doc_f
  ohmy_doc_f="$(mktemp)"; read_projected ohmy > "$ohmy_doc_f"
  opencode_doc_f="$(mktemp)"; printf '%s' "$opencode_doc" > "$opencode_doc_f"

  jq -n \
    --arg ohmyPath "$ohmy" \
    --arg ohmyScope "$(scope_for ohmy)" \
    --arg opencodePath "$opencode" \
    --arg homePath "$HOME_CFG" \
    --arg ohmyFp "$(fingerprint_logical ohmy)" \
    --arg opencodeFp "$(fingerprint_logical opencode)" \
    --argjson roster "$roster" \
    --argjson omoActive "$omo_active" \
    --argjson omoDeclared "$omo_declared" \
    --argjson omoInstalled "$omo_installed" \
    --argjson omoConfigured "$omo_configured" \
    --arg ocVersion "$oc_version" \
    --arg omoVersion "$omo_version" \
    --argjson authed "$authed" \
    --argjson pids "$pids" \
    --argjson shadows "$shadows" \
    --argjson ohmyExists "$([ -f "$ohmy" ] && echo true || echo false)" \
    --argjson opencodeExists "$([ -f "$opencode" ] && echo true || echo false)" \
    --argjson homeExists "$([ -f "$HOME_CFG" ] && echo true || echo false)" \
    --argjson ohmyParses "$([ -f "$ohmy" ] && [ "$(read_projected ohmy)" != "null" ] && echo true || echo false)" \
    --argjson opencodeParses "$(jq -e . "$opencode" >/dev/null 2>&1 && echo true || echo false)" \
    --argjson ohmyWritable "$([ -w "$ohmy" ] || [ ! -e "$ohmy" ] && [ -w "$(dirname "$ohmy")" ] && echo true || echo false)" \
    --argjson opencodeWritable "$([ -w "$opencode" ] || [ ! -e "$opencode" ] && [ -w "$(dirname "$opencode")" ] && echo true || echo false)" \
    --slurpfile ohmyDocA "$ohmy_doc_f" \
    --slurpfile opencodeDocA "$opencode_doc_f" \
    --slurpfile homeDocA "$(readable_json "$HOME_CFG")" \
    '
    ( $ohmyDocA[0]     // null ) as $ohmyDoc     |
    ( $opencodeDocA[0] // null ) as $opencodeDoc |
    ( $homeDocA[0]     // null ) as $homeDoc     |
    def fmt(p): if (p|endswith(".jsonc")) then "jsonc" else "json" end;
    {
      ok: true,
      # Which half of the panel is real. A config file left behind by an uninstall
      # is not evidence the plugin runs, so the shape follows the software: an
      # oh-my-openagent that opencode actually loads, or plain opencode.
      shape: (if $omoActive then "oh-my-openagent" else "opencode" end),
      ohMy: {
        active: $omoActive,
        declaredInOpencodeJson: $omoDeclared,
        installed: $omoInstalled,
        configured: $omoConfigured,
        # A config nobody loads. Worth saying out loud rather than acting on.
        stale: ($omoConfigured and ($omoActive | not))
      },
      roster: $roster,
      opencodeVersion: $ocVersion,
      ohMyVersion: $omoVersion,
      authedProviders: $authed,
      running: { pids: $pids, count: ($pids|length) },
      files: {
        ohmy: {
          path: $ohmyPath, exists: $ohmyExists, format: fmt($ohmyPath),
          # "" for a legacy per-harness file, "[opencode]" for the unified one.
          scope: ($ohmyScope | fromjson | join(".")),
          parses: $ohmyParses, writable: $ohmyWritable, fingerprint: $ohmyFp,
          agents:     (($ohmyDoc.agents     // {}) | keys),
          categories: (($ohmyDoc.categories // {}) | keys),
          unmanagedTopLevelKeys:
            (($ohmyDoc // {}) | keys | map(select(. as $k | ["agents","categories","fallback_models"] | index($k) | not)))
        },
        opencode: {
          path: $opencodePath, exists: $opencodeExists, format: fmt($opencodePath),
          parses: $opencodeParses, writable: $opencodeWritable, fingerprint: $opencodeFp,
          model: ($opencodeDoc.model // null),
          smallModel: ($opencodeDoc.small_model // null),
          agentKeys: (($opencodeDoc.agent // {}) | keys),
          unmanagedTopLevelKeys:
            (($opencodeDoc // {}) | keys | map(select(. as $k | ["model","small_model","agent"] | index($k) | not)))
        },
        home: {
          path: $homePath, exists: $homeExists,
          keys: (($homeDoc // {}) | keys),
          # A model or agent key here is loaded last and beats everything this
          # plugin writes. Saying so is the whole reason the file is reported.
          overrides: (($homeDoc // {}) | keys | map(select(. == "model" or . == "agent" or . == "small_model")))
        }
      },
      warnings:
        ( (if $ohmyExists and ($ohmyParses|not) then [{code:"E_PARSE", file:$ohmyPath}] else [] end)
        + (if $opencodeExists and ($opencodeParses|not) then [{code:"E_PARSE", file:$opencodePath}] else [] end)
        + (if ($omoConfigured and ($omoActive|not)) then [{code:"W_OHMY_STALE", file:$ohmyPath}] else [] end)
        + ($shadows | map({code:"W_SHADOWED", dir:.}))
        + (($homeDoc // {}) | keys | map(select(. == "model" or . == "agent"))
             | map({code:"W_HOME_OVERRIDE", key:., file:$homePath})) )
    }' | head -c "$MAX_EMIT_BYTES"

  rm -f "$ohmy_doc_f" "$opencode_doc_f"
}

# ---------------------------------------------------------------- validation

# Refuse before writing rather than explain after: every check here would otherwise
# produce a config that loads but silently does not do what the profile says.
preflight() {
  local logical="$1" payload="$2" file="$3"

  [ -f "$file" ] || refuse "E_MISSING" "$(basename "$file") does not exist."
  # A .jsonc used to be refused outright because jq cannot read comments. The edit
  # is a splice now, so comments survive it and the file is editable like any other.
  [ "$(read_projected "$logical")" != "null" ] \
    || refuse "E_PARSE" "$(basename "$file") will not parse. Nothing was changed."
  [ -w "$file" ] || refuse "E_PERM" "Cannot write $(basename "$file")."

  # Every model reference must look like provider/model. A typo here reaches
  # opencode as an unknown provider and takes the agent down with it.
  local bad
  bad=$(printf '%s' "$payload" | jq -r '
    [ .. | objects | select(has("model")) | .model ]
    | map(select(type=="string")) | map(select(length > 0))
    | map(select(test("^[A-Za-z0-9~._-]+(/[^/[:space:]]+)+$") | not))
    | unique | .[]' 2>/dev/null | head -1)
  [ -z "$bad" ] || refuse "E_MODEL_SYNTAX" "\"$bad\" is not a provider/model id."

  # opencode's AgentConfig is an object and its schema has no string branch, so a
  # bare model string under `agent` is a config that will not load. The panel writes
  # the long form; this is the gate that makes that a guarantee rather than a habit.
  if [ "$logical" = "opencode" ]; then
    local bare
    bare=$(printf '%s' "$payload" | jq -r '
      (.agent // {}) | to_entries | map(select(.value | type != "object")) | .[0].key // empty' 2>/dev/null)
    [ -z "$bare" ] || refuse "E_AGENT_SHAPE" \
      "\"$bare\" is set to a bare model string; opencode needs { \"model\": ... } there."
  fi

  if [ "$logical" = "ohmy" ]; then
    local forbidden
    forbidden=$(printf '%s' "$payload" | jq -r --argjson f "$OHMY_FORBIDDEN_FIELDS" '
      [ (.agents // {}), (.categories // {}) ]
      | map(to_entries[] | .value | select(type=="object") | keys[])
      | flatten | map(select(. as $k | $f | index($k))) | unique | .[]' 2>/dev/null | head -1)
    [ -z "$forbidden" ] || refuse "E_FIELD_4X" \
      "This profile sets \"$forbidden\", which oh-my-openagent drops the whole agent over."
  fi
}

# A restore writes a whole file rather than a few keys, so it gets the same gate
# a forward write does — the one path that used to skip every check.
preflight_restore() {
  local dest="$1" src="$2"
  if [ -e "$dest" ] && [ ! -w "$dest" ]; then refuse "E_PERM" "Cannot write $(basename "$dest")."; fi
  # A backup is a byte copy of whatever the file was, comments and all, so it is
  # read back the same way the live file is.
  "$JSONC" read "$src" >/dev/null 2>&1 \
    || refuse "E_PARSE" "That backup is not readable any more."
}

# Deliberately not a pipeline stage: refuse() inside a pipeline exits only the
# subshell, and an edit that never landed would still be announced as saved.
store_update() {
  local next
  next=$(jq "$@" "$PROFILES") || refuse "E_STORE" "Could not update the profile store."
  [ -n "$next" ] || refuse "E_STORE" "Could not update the profile store."
  printf '%s\n' "$next" | atomic_write "$PROFILES" \
    || refuse "E_STORE" "Could not save the profile store."
}

# `manages` arrives from the store, which a hand edit can write. Unclamped it would let
# a profile assign or delete mcp, provider or plugin — the keys this design never touches.
clamp_manages() {
  printf '%s' "$1" | jq -c --argjson a "$2" 'map(select(. as $k | $a | index($k)))'
}

# ---------------------------------------------------------------- apply

cmd_apply() {
  local id="${1:-}"
  [ -n "$id" ] || die "usage: oc-profiles apply <profile-id>"
  ensure_state
  take_lock

  local profile
  profile=$(jq -c --arg id "$id" '.profiles[] | select(.id == $id)' "$PROFILES" 2>/dev/null)
  [ -n "$profile" ] || refuse "E_NO_PROFILE" "No profile called \"$id\"."

  local targets applied=() skipped=() stamp dir
  targets=$(printf '%s' "$profile" | jq -c '.targets[]?')
  [ -n "$targets" ] || refuse "E_EMPTY_PROFILE" "\"$id\" does not describe any config."

  # Preflight everything before touching anything. A profile that would fail on
  # its second file must not have written its first.
  local logical payload file
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    logical=$(printf '%s' "$target" | jq -r '.file')
    if ! applicable "$logical"; then skipped+=("$logical"); continue; fi
    payload=$(printf '%s' "$target" | jq -c '.payload // {}')
    file="$(file_for "$logical")"
    preflight "$logical" "$payload" "$file"
  done <<< "$targets"

  stamp="$(new_backup_stamp)"
  dir="$BACKUPS/$stamp"
  mkdir -p "$dir" || refuse "E_PERM" "Cannot create a backup directory."

  local from_id backup_files='[]'
  from_id=$(jq -r '.state.activeProfileId // ""' "$PROFILES")

  # Byte copies, taken before the first write: restoring is a copy back, not a
  # re-serialisation, so an undo returns the file with the user's own formatting.
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    logical=$(printf '%s' "$target" | jq -r '.file')
    applicable "$logical" || continue
    file="$(file_for "$logical")"
    cp -pL "$file" "$dir/$logical.json" || refuse "E_PERM" "Cannot back up $(basename "$file")."
    backup_files=$(jq -cn --argjson acc "$backup_files" --arg l "$logical" --arg p "$file" \
      --arg fp "$(fingerprint_logical "$logical")" \
      '$acc + [{logical:$l, path:$p, fingerprint:$fp}]')
  done <<< "$targets"

  jq -n --arg ts "$stamp" --arg from "$from_id" --arg to "$id" --argjson files "$backup_files" \
    '{ts:$ts, fromProfileId:(if $from=="" then null else $from end), toProfileId:$to, files:$files}' \
    > "$dir/meta.json"

  # Write. Any failure rolls every already-written file back from the copies
  # above, so a switch is all of itself or none of it.
  local wrote=()
  local rc=0
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    logical=$(printf '%s' "$target" | jq -r '.file')
    applicable "$logical" || continue
    payload=$(printf '%s' "$target" | jq -c '.payload // {}')
    file="$(file_for "$logical")"

    # A key the profile carries is assigned, a managed key it omits is deleted — the half
    # a deep merge cannot do, and why switching away can remove an agent again.
    local mkeys
    mkeys=$(printf '%s' "$target" | jq -c --argjson d "$(keys_for "$logical")" '.manages // $d')
    mkeys=$(clamp_manages "$mkeys" "$(keys_for "$logical")")

    # Recorded before the write, not after: a write that fails part-way is
    # exactly the one the rollback has to cover.
    wrote+=("$logical")
    if ! write_projected "$logical" "$payload" "$mkeys" | atomic_write "$file"; then
      rc=1; break
    fi
    if [ "$(read_projected "$logical")" = "null" ]; then rc=1; break; fi
    applied+=("$logical")
  done <<< "$targets"

  if [ "$rc" -ne 0 ]; then
    local l
    for l in "${wrote[@]:-}"; do
      [ -n "$l" ] || continue
      cp -p "$dir/$l.json" "$(file_for "$l")" 2>/dev/null || true
    done
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The write failed and the previous config was put back.", backup:$backup}'
    exit 3
  fi

  # Stamp the store with fresh fingerprints read back off the files we just
  # wrote, so drift is measured against reality rather than against intent.
  local new_targets='[]' l fp
  for l in "${applied[@]:-}"; do
    [ -n "$l" ] || continue
    fp="$(fingerprint_logical "$l")"
    new_targets=$(jq -cn --argjson acc "$new_targets" --arg l "$l" --arg fp "$fp" '$acc + [{file:$l, fingerprint:$fp}]')
  done

  store_update --arg id "$id" --arg from "$from_id" --arg at "$(now_iso)" --arg backup "$stamp" \
     --argjson fps "$new_targets" '
     .state.previousProfileId = (if $from == "" then null else $from end)
   | .state.activeProfileId = $id
   | .state.appliedAt = $at
   | .state.lastBackup = $backup
   | .profiles = ( .profiles | map(
       if .id == $id then
         .targets = ( .targets | map( . as $t
           | ([$fps[] | select(.file == $t.file) | .fingerprint] | first) as $fp
           | if $fp then .fingerprint = $fp else . end ) )
       else . end ) )
   '

  prune_backups

  local reloaded=0
  if [ "$OC_AUTO_RELOAD" = 1 ]; then reload_opencode && reloaded=1; fi

  jq -cn --argjson applied "$(printf '%s\n' "${applied[@]:-}" | jq -R . | jq -sc 'map(select(length>0))')" \
         --argjson skipped "$(printf '%s\n' "${skipped[@]:-}" | jq -R . | jq -sc 'map(select(length>0))')" \
         --arg backup "$stamp" --arg id "$id" --argjson reloaded "$reloaded" \
    '{ok:true, activeProfileId:$id, applied:$applied, skipped:$skipped, backup:$backup, reloaded:$reloaded}'
}

# ---------------------------------------------------------------- revert

cmd_revert() {
  ensure_state
  take_lock

  local ts
  ts="${1:-$(jq -r '.state.lastBackup // ""' "$PROFILES")}"
  [ -n "$ts" ] || refuse "E_NO_BACKUP" "There is no backup to go back to."
  # A backup name is a timestamp this script wrote. Anything else is not a
  # backup, and a path fragment is certainly not one.
  case "$ts" in
    */*|*..*) refuse "E_NO_BACKUP" "\"$ts\" is not a backup name." ;;
  esac
  case "$ts" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]-[0-9][0-9]-[0-9][0-9]Z) ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]-[0-9][0-9]-[0-9][0-9]Z-[1-9]) ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]-[0-9][0-9]-[0-9][0-9]Z-[1-9][0-9]) ;;
    *) refuse "E_NO_BACKUP" "\"$ts\" is not a backup name." ;;
  esac
  local dir="$BACKUPS/$ts"
  [ -f "$dir/meta.json" ] || refuse "E_NO_BACKUP" "Backup $ts is gone."

  # A revert is a write like any other, so it gets its own backup first: undo
  # has to be undoable or it is just a second way to lose the config.
  local stamp new_dir
  stamp="$(new_backup_stamp)"; new_dir="$BACKUPS/$stamp"
  mkdir -p "$new_dir"

  local files logical path
  files=$(jq -c '.files[]' "$dir/meta.json")
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    logical=$(printf '%s' "$f" | jq -r '.logical')
    path="$(file_for "$logical")"
    if [ -f "$path" ]; then
      cp -pL "$path" "$new_dir/$logical.json" \
        || refuse "E_PERM" "Cannot back up $(basename "$path") before undoing."
    fi
  done <<< "$files"

  local to_id new_files='[]'
  to_id=$(jq -r '.state.activeProfileId // ""' "$PROFILES")
  # Describe the state this backup actually holds, not the one it is undoing.
  # Copying the old meta forward made a backup advertise someone else's digests.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    logical=$(printf '%s' "$f" | jq -r '.logical')
    [ -f "$new_dir/$logical.json" ] || continue
    new_files=$(jq -cn --argjson acc "$new_files" --arg l "$logical" --arg p "$(file_for "$logical")" \
      --arg fp "$(fingerprint_logical "$logical")" '$acc + [{logical:$l, path:$p, fingerprint:$fp}]')
  done <<< "$files"
  jq -n --arg ts "$stamp" --arg from "$to_id" --argjson files "$new_files" \
    '{ts:$ts, fromProfileId:(if $from=="" then null else $from end), toProfileId:null, files:$files}' \
    > "$new_dir/meta.json"

  # Gate every restore before performing any of them. Checking inside the write
  # loop meant a refusal on the second file left the first one already rolled
  # back, under an exit code that promises nothing was written.
  local restorable='[]'
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    logical=$(printf '%s' "$f" | jq -r '.logical')
    # The path the backup came FROM, not whatever resolves today.
    path=$(printf '%s' "$f" | jq -r '.path // empty')
    [ -n "$path" ] || path="$(file_for "$logical")"
    # Restores land only where this tool writes. $OMO_DIR is on the list because
    # oh-my-openagent's config lives there — without it an undo silently skipped
    # the whole oh-my-openagent half and still reported success.
    case "$path" in "$CFG_DIR"/*|"$OMO_DIR"/*|"$HOME_CFG") ;; *) continue ;; esac
    [ -f "$dir/$logical.json" ] || continue
    preflight_restore "$path" "$dir/$logical.json"
    restorable=$(jq -cn --argjson acc "$restorable" --arg l "$logical" --arg p "$path" \
      '$acc + [{logical:$l, path:$p}]')
  done <<< "$files"

  local restored='[]' put_back=() rrc=0
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    logical=$(printf '%s' "$entry" | jq -r '.logical')
    path=$(printf '%s' "$entry" | jq -r '.path')
    put_back+=("$logical")
    if ! cat "$dir/$logical.json" | atomic_write "$path"; then rrc=1; break; fi
    restored=$(jq -cn --argjson acc "$restored" --arg l "$logical" '$acc + [$l]')
  done <<< "$(printf '%s' "$restorable" | jq -c '.[]')"

  if [ "$rrc" -ne 0 ]; then
    local l
    for l in "${put_back[@]:-}"; do
      [ -n "$l" ] || continue
      [ -f "$new_dir/$l.json" ] && cp -p "$new_dir/$l.json" "$(file_for "$l")" 2>/dev/null || true
    done
    jq -cn --arg backup "$stamp" \
      '{ok:false, code:"E_WRITE", message:"The undo failed and the config was put back as it was.", backup:$backup}'
    exit 3
  fi

  local back_to
  back_to=$(jq -r '.fromProfileId // ""' "$dir/meta.json")
  store_update --arg id "$back_to" --arg prev "$to_id" --arg at "$(now_iso)" --arg backup "$stamp" '
      .state.activeProfileId = (if $id == "" then null else $id end)
    | .state.previousProfileId = (if $prev == "" then null else $prev end)
    | .state.appliedAt = $at
    | .state.lastBackup = $backup
  '

  prune_backups

  local reloaded=0
  if [ "$OC_AUTO_RELOAD" = 1 ]; then reload_opencode && reloaded=1; fi

  jq -cn --arg ts "$ts" --arg backup "$stamp" --argjson restored "$restored" \
         --arg id "$back_to" --argjson reloaded "$reloaded" \
    '{ok:true, reverted:$ts, backup:$backup, restored:$restored,
      activeProfileId:(if $id=="" then null else $id end), reloaded:$reloaded}'
}

prune_backups() {
  [ "$OC_BACKUPS_KEEP" -ge 0 ] 2>/dev/null || return 0

  # The backup the store points at is the one Undo restores, so it is never a candidate:
  # with keepBackups 0 the prune would delete the copy taken seconds earlier.
  local keep_ts
  keep_ts=$(jq -r '.state.lastBackup // ""' "$PROFILES" 2>/dev/null)

  local doomed
  doomed=$(ls -1d "$BACKUPS"/*/ 2>/dev/null | sort | head -n "-$OC_BACKUPS_KEEP" 2>/dev/null)
  [ -n "$doomed" ] || return 0

  local d name
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    case "$d" in "$BACKUPS"/*) ;; *) continue ;; esac
    name=$(basename "${d%/}")
    [ "$name" = "$keep_ts" ] && continue
    [ -L "${d%/}" ] && { rm -f "${d%/}"; continue; }
    [ -d "${d%/}" ] || continue
    rm -rf "$d"
  done <<< "$doomed"
}

# ---------------------------------------------------------------- reload

# SIGUSR2 is opencode's own "re-read your config" signal, so a switch keeps the session.
# Only the TUI installs a handler and SIGUSR2's default disposition is death — check each pid.
catches_sigusr2() {
  local pid="$1" mask
  mask=$(awk '/^SigCgt:/{print $2}' "/proc/$pid/status" 2>/dev/null)
  [ -n "$mask" ] || return 1
  # SIGUSR2 is signal 12, so it is bit 11 of the caught-signal mask.
  python3 -c "import sys; sys.exit(0 if (int('$mask',16) >> 11) & 1 else 1)" 2>/dev/null
}

reloadable_pids() {
  local pid
  for pid in $(pgrep -x opencode 2>/dev/null); do
    catches_sigusr2 "$pid" && printf '%s\n' "$pid"
  done
}

reload_opencode() {
  local pids
  pids=$(reloadable_pids)
  [ -n "$pids" ] || return 1
  printf '%s\n' "$pids" | while IFS= read -r pid; do
    [ -n "$pid" ] && kill -USR2 "$pid" 2>/dev/null
  done
  return 0
}

cmd_reload() {
  local pids n total skipped
  pids=$(reloadable_pids)
  n=$(printf '%s' "$pids" | grep -c . 2>/dev/null || true)
  [ -n "$n" ] || n=0
  total=$(pgrep -cx opencode 2>/dev/null || true)
  [ -n "$total" ] || total=0
  skipped=$((total - n))

  if [ "$n" -gt 0 ]; then
    reload_opencode
    jq -cn --argjson n "$n" --argjson skipped "$skipped" \
      '{ok:true, reloaded:$n, skipped:$skipped}'
  elif [ "$total" -gt 0 ]; then
    jq -cn --argjson skipped "$skipped" \
      '{ok:true, reloaded:0, skipped:$skipped,
        message:"opencode is running but not listening for a config reload."}'
  else
    jq -cn '{ok:true, reloaded:0, skipped:0, message:"opencode is not running."}'
  fi
}

# ---------------------------------------------------------------- capture

# Turn what is on disk right now into a profile — how "Save current config" works.
cmd_capture() {
  local name="${1:-}" id="${2:-}"
  [ -n "$name" ] || die "usage: oc-profiles capture <name> [id]"
  ensure_state
  take_lock

  if [ -z "$id" ]; then
    id=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
    [ -n "$id" ] || id="profile"
    local base="$id" n=2
    while jq -e --arg i "$id" 'any(.profiles[]; .id == $i)' "$PROFILES" >/dev/null 2>&1; do
      id="$base-$n"; n=$((n+1))
    done
  fi

  local targets='[]' logical file doc
  for logical in ohmy opencode; do
    applicable "$logical" || continue
    file="$(file_for "$logical")"
    [ -f "$file" ] || continue
    local live; live="$(read_projected "$logical")"
    [ "$live" != "null" ] || continue
    doc=$(printf '%s' "$live" | jq -c --argjson m "$(keys_for "$logical")" \
      '. as $in | reduce $m[] as $k ({}; if ($in|has($k)) then .[$k]=$in[$k] else . end)')
    # `manages` is the whole key list, not just the keys that happen to be set.
    # A snapshot has to be able to restore a key being *absent*, or coming back to
    # it leaves behind whatever the profile you were on had added.
    targets=$(jq -cn --argjson acc "$targets" --arg l "$logical" --argjson p "$doc" \
      --argjson m "$(keys_for "$logical")" \
      --arg fp "$(fingerprint_logical "$logical")" \
      --arg shape "$([ "$logical" = ohmy ] && echo oh-my-openagent || echo opencode)" \
      '$acc + [{file:$l, shape:$shape, manages:$m, fingerprint:$fp, payload:$p}]')
  done

  # An opencode.json holding only providers and MCP servers is a perfectly normal
  # config and the most common one on the plain side. It captures as a profile that
  # pins nothing, which is a legitimate thing to come back to.
  [ "$targets" != "[]" ] || refuse "E_EMPTY" "No opencode config file to save."

  # Two or three letters keeps the bar a fixed width. Initials of every word, not the
  # first two letters: "Full Opus" is FO, "Full OX Alpha" is FOA; one word takes two.
  local short
  short=$(printf '%s' "$name" | awk '{
    n = split($0, w, /[ _-]+/)
    if (n >= 2) { out = ""; for (i = 1; i <= n && length(out) < 3; i++) out = out substr(w[i], 1, 1); print out }
    else print substr($0, 1, 2)
  }' | tr '[:lower:]' '[:upper:]')

  store_update --arg id "$id" --arg name "$name" --arg short "$short" --arg at "$(now_iso)" --argjson t "$targets" '
      .profiles = ( (.profiles | map(select(.id != $id)))
        + [{id:$id, name:$name, shortName:$short, description:"",
            createdAt:$at, updatedAt:$at, targets:$t}] )
  '

  jq -cn --arg id "$id" --arg name "$name" '{ok:true, id:$id, name:$name}'
}

# First run. A brand-new store means the panel would otherwise open on "Custom",
# an empty list and a warning that nothing matches — which reads like a fault
# when nothing is wrong. Capturing what is already there costs one read and
# gives the user their own setup to look at, and to come back to.
#
# Refuses once any profile exists, so it can never overwrite a real store. It
# writes no config file: the profile is taken FROM disk, so its fingerprints
# already match and marking it active is just bookkeeping.
cmd_seed() {
  ensure_state
  take_lock

  local existing
  existing=$(jq -r '.profiles | length' "$PROFILES" 2>/dev/null || echo 0)
  if [ "$existing" != "0" ]; then
    jq -cn '{ok:true, seeded:false, reason:"there are already profiles"}'
    return 0
  fi

  local ohmy opencode ok=0
  ohmy="$(resolve_ohmy)"; opencode="$(resolve_opencode)"
  for f in "$ohmy" "$opencode"; do
    [ -f "$f" ] && jq -e . "$f" >/dev/null 2>&1 && ok=1
  done
  if [ "$ok" != 1 ]; then
    jq -cn '{ok:true, seeded:false, reason:"no readable opencode config"}'
    return 0
  fi

  # cmd_capture takes the lock itself, so hand off rather than call it here.
  flock -u 9 2>/dev/null || true
  cmd_capture "Current config" current-config >/dev/null 2>&1 || {
    jq -cn '{ok:true, seeded:false, reason:"nothing in the config to save"}'
    return 0
  }

  store_update --arg id current-config --arg at "$(now_iso)" '
      .state.activeProfileId = $id
    | .state.appliedAt = $at
  '
  jq -cn '{ok:true, seeded:true, id:"current-config"}'
}

# ---------------------------------------------------------------- store edits

# The panel hands a whole profile object in on stdin. Passing it as an argument
# would put a config through argv and into every process listing on the box.
cmd_save() {
  ensure_state
  take_lock
  local incoming
  # Quickshell's Process has no way to write to a child's stdin, so the panel hands the
  # profile over in the environment; a terminal still pipes. Neither route uses argv.
  if [ -n "${OC_PROFILE_JSON:-}" ]; then incoming="$OC_PROFILE_JSON"; else incoming=$(cat); fi
  printf '%s' "$incoming" | jq -e '.id and .name' >/dev/null 2>&1 \
    || refuse "E_BAD_PROFILE" "That profile has no id or no name."

  # Fingerprints are derived here, never trusted from the caller: a profile duplicated in
  # the panel carries the original's digest and would claim to match a config it does not.
  local rebuilt='[]' t logical payload mkeys
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    logical=$(printf '%s' "$t" | jq -r '.file')
    payload=$(printf '%s' "$t" | jq -c '.payload // {}')
    mkeys=$(printf '%s' "$t" | jq -c --argjson d "$(keys_for "$logical")" '.manages // $d')
    mkeys=$(clamp_manages "$mkeys" "$(keys_for "$logical")")
    t=$(printf '%s' "$t" | jq -c --argjson m "$mkeys" '.manages = $m')
    rebuilt=$(jq -cn --argjson acc "$rebuilt" --argjson t "$t" \
      --arg fp "$(payload_fingerprint "$payload" "$(keys_for "$logical")")" \
      '$acc + [ $t + {fingerprint: $fp} ]')
  done <<< "$(printf '%s' "$incoming" | jq -c '.targets[]?')"
  incoming=$(printf '%s' "$incoming" | jq -c --argjson t "$rebuilt" '.targets = $t')

  store_update --argjson p "$incoming" --arg at "$(now_iso)" '
      .profiles = ( (.profiles | map(select(.id != $p.id)))
        + [ $p + {updatedAt:$at, createdAt:( $p.createdAt // $at )} ] )
  '

  printf '%s' "$incoming" | jq -c '{ok:true, id:.id}'
}

cmd_delete() {
  local id="${1:-}"
  [ -n "$id" ] || die "usage: oc-profiles delete <profile-id>"
  ensure_state
  take_lock
  jq -e --arg id "$id" 'any(.profiles[]; .id == $id)' "$PROFILES" >/dev/null 2>&1 \
    || refuse "E_NO_PROFILE" "No profile called \"$id\"."
  store_update --arg id "$id" '
      .profiles = (.profiles | map(select(.id != $id)))
    | .state.activeProfileId = (if .state.activeProfileId == $id then null else .state.activeProfileId end)
    | .state.previousProfileId = (if .state.previousProfileId == $id then null else .state.previousProfileId end)
  '
  jq -cn --arg id "$id" '{ok:true, deleted:$id}'
}

# The store plus the live fingerprints, which together answer the only question
# the panel opens with: is what is running still what the active profile says?
cmd_list() {
  ensure_state
  local ohmy_fp opencode_fp
  ohmy_fp="$(fingerprint_logical ohmy)"
  opencode_fp="$(fingerprint_logical opencode)"

  # This is the one command whose output grows with the store, so it is the one that
  # reads it through the guard rather than by handing jq a path to reopen. Bounding
  # the input is not enough on its own: jq's pretty-printer turned a 150 KB store
  # into 174 MB here, so the output is capped as well, and compact.
  local raw
  raw="$(read_store)" \
    || refuse "E_STORE" "The profile store is not a plain file, or is too large to read."

  # `matches` makes a switch made outside this panel recognisable rather than reported as
  # damage. No jq `//` near a boolean: `false // true` is `true`, marking clean as drifted.
  printf '%s' "$raw" | jq -c --arg ohmy "$ohmy_fp" --arg opencode "$opencode_fp" '
    . as $root
    | ($root.state.activeProfileId) as $id
    | def clean(p):
        (p.targets // [])
        | length > 0
        and ( map( .fingerprint == (if .file == "ohmy" then $ohmy else $opencode end) ) | all );
      . + { live: { ohmy: $ohmy, opencode: $opencode },
            matches: [ $root.profiles[] | select(clean(.)) | .id ] }
    | .drift = ( if $id == null then true
                 else ( [ $root.profiles[] | select(.id == $id) ]
                        | if length == 0 then true else (clean(.[0]) | not) end )
                 end )
  ' | head -c "$MAX_EMIT_BYTES"
}

# Favourites and recents live beside the profiles: one file, one writer, nothing second
# to keep in step.
cmd_prefs() {
  ensure_state
  take_lock
  local incoming
  if [ -n "${OC_PREFS_JSON:-}" ]; then incoming="$OC_PREFS_JSON"; else incoming=$(cat); fi
  printf '%s' "$incoming" | jq -e 'type == "object"' >/dev/null 2>&1 \
    || refuse "E_BAD_PREFS" "Preferences must be an object."

  store_update --argjson p "$incoming" '
      # Deduped without unique_by, which sorts. The order here is "most recently
      # starred first", and sorting it alphabetically throws away the only thing
      # that makes the top of the list worth having.
      .favorites = (($p.favorites // .favorites // []) | map(select(type == "string"))
                    | reduce .[] as $x ([]; if index([$x]) == null then . + [$x] else . end))
    | .recents   = (($p.recents   // .recents   // []) | map(select(type == "string")) | .[0:8])
  '

  jq -c '{ok:true, favorites:(.favorites|length), recents:(.recents|length)}' "$PROFILES"
}

cmd_backups() {
  ensure_state
  local out='[]' d
  for d in $(ls -1d "$BACKUPS"/*/ 2>/dev/null | sort -r); do
    [ -f "$d/meta.json" ] || continue
    out=$(jq -cn --argjson acc "$out" --argjson m "$(jq -c . "$d/meta.json")" '$acc + [$m]')
  done
  printf '%s\n' "$out"
}

usage() {
  cat <<'USAGE'
oc-profiles — read and switch opencode model profiles

  detect                    what is on disk, what is running, what is authed
  list                      the profile store plus live fingerprints and drift
  capture <name> [id]       save the live config as a new profile
  seed                      on an empty store, save the live config as the first profile
  apply <id>                switch to a profile (backs up, writes, reloads)
  revert [<backup-ts>]      put the previous config back
  save                      upsert a profile object from stdin or $OC_PROFILE_JSON
  delete <id>               remove a profile
  prefs                     upsert {favorites,recents} from stdin or $OC_PREFS_JSON
  backups                   every backup taken, newest first
  reload                    tell a running opencode to re-read its config

Settings come from the environment:
  OC_MANAGE_OHMY=1  OC_MANAGE_OPENCODE=1  OC_AUTO_RELOAD=1  OC_BACKUPS_KEEP=10
USAGE
}

# ---------------------------------------------------------------- entry

need jq
need date
need flock
need python3

case "${1:-}" in
  detect)   shift; cmd_detect "$@" ;;
  list)     shift; cmd_list "$@" ;;
  capture)  shift; cmd_capture "$@" ;;
  seed)     shift; cmd_seed "$@" ;;
  apply)    shift; cmd_apply "$@" ;;
  revert)   shift; cmd_revert "$@" ;;
  save)     shift; cmd_save "$@" ;;
  delete)   shift; cmd_delete "$@" ;;
  prefs)    shift; cmd_prefs "$@" ;;
  backups)  shift; cmd_backups "$@" ;;
  reload)   shift; cmd_reload "$@" ;;
  --version) printf '%s\n' "$VERSION" ;;
  -h|--help|"") usage ;;
  *) usage; exit 1 ;;
esac
